.patch fb_test
.title "doom-piano: Extra > DOOM starts a framebuffer test (far data, game loop, timings, the keys); a panel key stops it"
.requires extra_menu touch_off
; Generated by doom-piano/firmware/fbtest.py, do not edit by hand. Our own code and data only.

.hook 0x007ea expect 0xd7c8 0x4e75     ; tick_10ms: ccall lcd_refresh (sends the framebuffer when flagged)
    call  dp_tick
.end

.code
.equ dp_on, 0x6500
.equ dp_t, 0x6501
.equ dp_tk, 0x6502
.equ dp_sec, 0x6503
.equ dp_c0, 0x6504
.equ dp_d, 0x6505
.equ dp_b, 0x6506
.equ dp_l, 0x6507
.equ dp_n, 0x6508
.equ dp_x, 0x6509
.equ dp_dx, 0x650a
.equ dp_y, 0x650b
.equ dp_dy, 0x650c
.equ dp_lx, 0x650d
.equ dp_i, 0x650e
.equ dp_k, 0x650f
.equ dp_v, 0x6510
.equ dp_ad, 0x6511
.equ dp_fr, 0x6512
.equ dp_c1, 0x6513
.equ dp_note, 0x6560
.equ dp_keys, 0x6580
.equ dp_tab, 0x6514
.equ dp_div, 0x651e
.equ dp_fnt, 0x6530
.equ DP_MAGIC, 0x600d
.equ DP_PEND, 0x600e

dp_cpcard:                              ; 1024 words dp_card -> framebuffer, word for word as init_all's 0x4928
    .dw   0xc04c, 0x0004                ; enter #4
    .dw   0xf8d0 | (dp_card >> 16), dp_card & 0xffff  ; li32 L0, program pointer (0x4928: f8d1 2cf7)
    .dw   0xd3c8, 0xffff                ; st [fp-1], r0
    .dw   0xd3c9, 0xfffe                ; st [fp-2], r1
    li    r0, #framebuffer
    .dw   0x8109                        ; mov r1, x9
    li    r7, #1024
    .dw   0xfae2, 0xfffe                ; ld32 L2, [fp-2]
    .dw   0xfaf7                        ; fix32 L2: source
    .dw   0xf148                        ; mov32 L1, L0: destination r2 = RAM address, r3 = x9
    call  0x7638
    .dw   0xd5c8                        ; ret_pop #0
.end

.code 0x1a280
dm_start:                               ; extra_menu's item 7 (Enter): Extra redraws itself next, so the tick
    li    r6, #DP_PEND                  ; starts the test (dp_go). On only while dp_on holds DP_MAGIC: after
    st    [dp_on], r6                   ; init_all this RAM holds leftovers (0x6b at dp_on)
    ret

dm_icon:                                ; extra_menu draws page 3: a skull in item 7's place, straight into the
    mov   r7, #0x80
    st    [0x6760], r7
    mov   r7, #0xe0
    st    [0x6761], r7
    mov   r7, #0xf0
    st    [0x6762], r7
    mov   r7, #0xf8
    st    [0x6763], r7
    mov   r7, #0xfc
    st    [0x6764], r7
    mov   r7, #0xfc
    st    [0x6765], r7
    mov   r7, #0xfe
    st    [0x6766], r7
    mov   r7, #0xfe
    st    [0x6767], r7
    mov   r7, #0xfe
    st    [0x6768], r7
    mov   r7, #0xfe
    st    [0x6769], r7
    mov   r7, #0xfe
    st    [0x676a], r7
    mov   r7, #0xfe
    st    [0x676b], r7
    mov   r7, #0xfe
    st    [0x676c], r7
    mov   r7, #0xfe
    st    [0x676d], r7
    mov   r7, #0xfc
    st    [0x676e], r7
    mov   r7, #0xfc
    st    [0x676f], r7
    mov   r7, #0xf8
    st    [0x6770], r7
    mov   r7, #0xf0
    st    [0x6771], r7
    mov   r7, #0xe0
    st    [0x6772], r7
    mov   r7, #0x80
    st    [0x6773], r7
    mov   r7, #0x3f
    st    [0x67e0], r7
    mov   r7, #0x7f
    st    [0x67e1], r7
    mov   r7, #0xff
    st    [0x67e2], r7
    mov   r7, #0xf3
    st    [0x67e3], r7
    mov   r7, #0xe1
    st    [0x67e4], r7
    mov   r7, #0xe1
    st    [0x67e5], r7
    mov   r7, #0xe1
    st    [0x67e6], r7
    mov   r7, #0xe1
    st    [0x67e7], r7
    mov   r7, #0x73
    st    [0x67e8], r7
    mov   r7, #0x1f
    st    [0x67e9], r7
    mov   r7, #0x1f
    st    [0x67ea], r7
    mov   r7, #0x73
    st    [0x67eb], r7
    mov   r7, #0xe1
    st    [0x67ec], r7
    mov   r7, #0xe1
    st    [0x67ed], r7
    mov   r7, #0xe1
    st    [0x67ee], r7
    mov   r7, #0xe1
    st    [0x67ef], r7
    mov   r7, #0xf3
    st    [0x67f0], r7
    mov   r7, #0xff
    st    [0x67f1], r7
    mov   r7, #0x7f
    st    [0x67f2], r7
    mov   r7, #0x3f
    st    [0x67f3], r7
    mov   r7, #0x01
    st    [0x6863], r7
    mov   r7, #0x0f
    st    [0x6864], r7
    mov   r7, #0x1b
    st    [0x6865], r7
    mov   r7, #0x2f
    st    [0x6866], r7
    mov   r7, #0x3f
    st    [0x6867], r7
    mov   r7, #0x3b
    st    [0x6868], r7
    mov   r7, #0x2f
    st    [0x6869], r7
    mov   r7, #0x3f
    st    [0x686a], r7
    mov   r7, #0x3b
    st    [0x686b], r7
    mov   r7, #0x2f
    st    [0x686c], r7
    mov   r7, #0x3f
    st    [0x686d], r7
    mov   r7, #0x0b
    st    [0x686e], r7
    mov   r7, #0x0f
    st    [0x686f], r7
    mov   r7, #0x01
    st    [0x6870], r7                                  ; framebuffer (the screen was cleared)
    ret

dm_panel:                               ; key_event (real fp: [fp+3] key, [fp+2] state, 0 = pressed); in and out
    ld    r7, [dp_on]                   ; r6 = r7 = 0 (key_event zeroes idle_ticks with them). While on, every
    li    r6, #DP_MAGIC                 ; panel key is ours: it becomes 0x7f, which no handler takes (0x38dd); a
    cmp   r7, r6                        ; press stops the test and redraws the screen (Extra)
    bne   .po
    .dw   0xd2cf, 0x0002                ; ld r7, [fp+2]: state
    cmp   r7, #0
    bne   .pe
    st    [dp_on], r7
    ld    r7, [screen]
    push  r7
    ccall draw_screen
.pe:
    mov   r7, #0x7f
    .dw   0xd3cf, 0x0003                ; st [fp+3], r7
.po:
    mov   r6, #0
    mov   r7, #0
    ret

dm_key:                                 ; touch_off, task_key_events: r1 = the event ([+3] type: 9 on, 8 off,
    cmp   r7, #9                        ; [+4] key, [+5] velocity), r7 = its type; keeps r1 and r3 (the asm's
    beq   .kk                           ; "fp"), r7 = the type to go on with. While on, notes are ours: type 0,
    cmp   r7, #8                        ; which nothing handles (0x2918 -> the common end 0x2ca2)
    beq   .kk
    ret
.kk:
    ld    r6, [dp_on]
    li    r5, #DP_MAGIC
    cmp   r6, r5
    beq   .km
    ret
.km:
    ld    r6, [r1+5]                    ; velocity, 0 = released
    cmp   r7, #8
    bne   .kn
    mov   r6, #0
.kn:
    ld    r5, [r1+4]
    and   r5, #0x7f
    cmp   r6, #0
    beq   .ks
    st    [dp_note], r5
.ks:
    mov   r4, r1
    li    r1, #dp_keys
    add   r1, r5
    st    [r1+0], r6                    ; dp_keys[key] = velocity
    mov   r1, r4
    mov   r7, #0
    st    [0x000b], r7                  ; idle_ticks = 0, as the firmware does for a note (no sleep while playing)
    st    [0x000c], r7
    st    [r1+3], r7
    ret

dp_go:                                  ; the tick after dm_start
    li    r6, #DP_MAGIC
    st    [dp_on], r6
    mov   r7, #0
    st    [dp_t], r7
    st    [dp_tk], r7
    st    [dp_sec], r7
    st    [dp_d], r7
    st    [dp_b], r7
    st    [dp_l], r7
    st    [dp_lx], r7
    st    [dp_fr], r7
    mov   r7, #40
    st    [dp_x], r7
    mov   r7, #20
    st    [dp_y], r7
    mov   r7, #1
    st    [dp_dx], r7
    st    [dp_dy], r7
    call  dp_init                       ; table, divisors and font: far code storing immediates (known to work)
    ccall dp_cpcard                     ; the card: far data through the firmware's copy routine (the test);
                                        ; ccall: enter/ret_pop functions are always ccall'ed (919 of 919)
    ld    r7, [0x6a50]                  ; bit 0: the tick sends the framebuffer to the LCD
    mov   r6, #1
    or    r7, r6
    st    [0x6a50], r7
    ret

dp_tick:                                ; in place of tick_10ms's ccall lcd_refresh
    ld    r7, [dp_on]
    li    r6, #DP_PEND
    cmp   r7, r6
    bne   .on
    call  dp_go
    jmp   .refresh
.on:
    li    r6, #DP_MAGIC
    cmp   r7, r6
    bne   .refresh
    ld    r7, [dp_t]                    ; ticks since start, up to 303: card 0..299, benchmarks 300..302
    li    r6, #303
    cmp   r7, r6
    blt   .count
    jmp   .run
.count:
    add   r7, #1
    st    [dp_t], r7
    li    r6, #300                      ; the card stays 3 s
    cmp   r7, r6
    blt   .refresh
    bne   .b1
    call  dp_bench_r                    ; each benchmark is timed across the next main loop pass, which folds
    jmp   .refresh                      ; the timer interrupts that came meanwhile into its clock
.b1:
    li    r6, #301
    cmp   r7, r6
    bne   .b2
    call  dp_bench_l
    jmp   .refresh
.b2:
    call  dp_now
    ld    r6, [dp_c1]
    .dw   0xaf06                        ; sub r7, r6
    st    [dp_l], r7
    call  dp_now
    st    [dp_c0], r7
.run:
    ld    r7, [dp_tk]
    add   r7, #1
    st    [dp_tk], r7
    cmp   r7, #100
    blt   .draw
    mov   r7, #0
    st    [dp_tk], r7
    ld    r7, [dp_sec]
    add   r7, #1
    st    [dp_sec], r7
    call  dp_now
    ld    r6, [dp_c0]
    st    [dp_c0], r7
    .dw   0xaf06                        ; sub r7, r6
    st    [dp_d], r7
.draw:
    ld    r7, [dp_fr]                   ; a frame every FRAME_TICKS ticks: at 100 fps the STN LCD shows a pale smear
    add   r7, #1
    st    [dp_fr], r7
    cmp   r7, #5
    blt   .refresh
    mov   r7, #0
    st    [dp_fr], r7
    call  dp_frame
.refresh:
    ccall 0x4e75
    ret

dp_now:                                 ; r7 = the main loop clock in units of 1024 us (~ms), mod 65536
    ld    r7, [0x6d79]          ; (hi << 6) | (lo >> 10): no carries to handle, differences stay right
    shl   r7, 6
    ld    r6, [0x6d78]
    shr   r6, 10
    and   r6, #0x3f
    or    r7, r6
    ret

dp_bench_r:                             ; 100 frames back to back; R = their time, read at the next tick
    call  dp_now
    st    [dp_c1], r7
    mov   r7, #100
    st    [dp_n], r7
.r:
    call  dp_frame
    ld    r7, [dp_n]
    li    r6, #0xffff
    add   r7, r6
    st    [dp_n], r7
    cmp   r7, #0
    bne   .r
    ret

dp_bench_l:                             ; R done; 100 refreshes of the whole LCD, L read at the next tick
    call  dp_now
    ld    r6, [dp_c1]
    .dw   0xaf06                        ; sub r7, r6
    st    [dp_b], r7
    call  dp_now
    st    [dp_c1], r7
    mov   r7, #100
    st    [dp_n], r7
.l:
    ld    r7, [0x6a50]
    mov   r6, #1
    or    r7, r6
    st    [0x6a50], r7
    ccall 0x4e75
    ld    r7, [dp_n]
    li    r6, #0xffff
    add   r7, r6
    st    [dp_n], r7
    cmp   r7, #0
    bne   .l
    ret

; one whole frame into the framebuffer, then the refresh flag (leaf)
dp_frame:
    li    r1, #framebuffer
    li    r6, #(framebuffer + 1024)
    mov   r7, #0
.clr:
    st    [r1+0], r7
    st    [r1+1], r7
    st    [r1+2], r7
    st    [r1+3], r7
    add   r1, #4
    cmp   r1, r6
    bne   .clr
    ld    r7, [dp_lx]                   ; a vertical line sweeping the screen
    add   r7, #1
    and   r7, #127
    st    [dp_lx], r7
    li    r1, #framebuffer
    add   r1, r7
    mov   r6, #0xff
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    ld    r7, [dp_x]                    ; the box bounces in x 32..120, y 0..56
    mov   r6, #0                        ; dx from the keys: C3 left, E3 right, 2 px a frame
    ld    r5, [dp_keys + 52]
    cmp   r5, #0
    beq   .kr
    add   r6, #2
.kr:
    ld    r5, [dp_keys + 48]
    cmp   r5, #0
    beq   .kl
    li    r5, #0xfffe
    add   r6, r5
.kl:
    add   r7, r6
    st    [dp_x], r7
    cmp   r7, #120                      ; bounce and clamp: the box is drawn at fb + page*128 + x, so x and y
    blt   .x1                           ; must stay in range whatever the RAM held (the first build wrote far
    li    r6, #0xffff                   ; outside the framebuffer from power-on leftovers and crashed)
    st    [dp_dx], r6
    mov   r7, #120
    st    [dp_x], r7
.x1:
    cmp   r7, #33
    blt   .x2
    jmp   .x3
.x2:
    mov   r6, #1
    st    [dp_dx], r6
    mov   r7, #32
    st    [dp_x], r7
.x3:
    ld    r7, [dp_y]
    mov   r6, #0                        ; dy: D3 down, C#3 or D#3 up
    ld    r5, [dp_keys + 50]
    cmp   r5, #0
    beq   .kd
    add   r6, #2
.kd:
    ld    r5, [dp_keys + 49]
    ld    r4, [dp_keys + 51]
    or    r5, r4
    cmp   r5, #0
    beq   .ku
    li    r5, #0xfffe
    add   r6, r5
.ku:
    add   r7, r6
    st    [dp_y], r7
    cmp   r7, #56
    blt   .y1
    li    r6, #0xffff
    st    [dp_dy], r6
    mov   r7, #56
    st    [dp_y], r7
.y1:
    cmp   r7, #1
    blt   .y2
    jmp   .y3
.y2:
    mov   r6, #1
    st    [dp_dy], r6
    mov   r7, #0
    st    [dp_y], r7
.y3:
    mov   r6, r7                        ; r6 = y & 7, r7 = page
    and   r6, #7
    shr   r7, 3
    mov   r5, #0xff                     ; r5 = rows in this page, r4 = rows in the next one
    mov   r4, #0xff
    mov   r2, #0
.m:
    cmp   r2, r6
    blt   .ms
    shr   r4, 1
    jmp   .mn
.ms:
    shl   r5, 1
.mn:
    add   r2, #1
    cmp   r2, #8
    bne   .m
    and   r5, #0xff
    shl   r7, 7
    li    r1, #framebuffer
    add   r1, r7
    ld    r7, [dp_x]
    add   r1, r7
    ld    r7, [r1+0]
    or    r7, r5
    st    [r1+0], r7
    ld    r7, [r1+1]
    or    r7, r5
    st    [r1+1], r7
    ld    r7, [r1+2]
    or    r7, r5
    st    [r1+2], r7
    ld    r7, [r1+3]
    or    r7, r5
    st    [r1+3], r7
    ld    r7, [r1+4]
    or    r7, r5
    st    [r1+4], r7
    ld    r7, [r1+5]
    or    r7, r5
    st    [r1+5], r7
    ld    r7, [r1+6]
    or    r7, r5
    st    [r1+6], r7
    ld    r7, [r1+7]
    or    r7, r5
    st    [r1+7], r7
    cmp   r4, #0
    beq   .nohi
    add   r1, #128
    ld    r7, [r1+0]
    or    r7, r4
    st    [r1+0], r7
    ld    r7, [r1+1]
    or    r7, r4
    st    [r1+1], r7
    ld    r7, [r1+2]
    or    r7, r4
    st    [r1+2], r7
    ld    r7, [r1+3]
    or    r7, r4
    st    [r1+3], r7
    ld    r7, [r1+4]
    or    r7, r4
    st    [r1+4], r7
    ld    r7, [r1+5]
    or    r7, r4
    st    [r1+5], r7
    ld    r7, [r1+6]
    or    r7, r4
    st    [r1+6], r7
    ld    r7, [r1+7]
    or    r7, r4
    st    [r1+7], r7
.nohi:
    mov   r7, #0                        ; the numbers: line i in page i, a letter and 5 digits
    st    [dp_i], r7
.line:
    ld    r7, [dp_i]
    shl   r7, 7
    li    r6, #framebuffer
    add   r7, r6
    st    [dp_ad], r7
    ld    r7, [dp_i]
    shl   r7, 1
    li    r1, #dp_tab
    add   r1, r7
    ld    r6, [r1+0]                    ; the letter
    ld    r1, [r1+1]                    ; the variable
    ld    r7, [r1+0]
    st    [dp_v], r7
    mov   r7, #0
    st    [dp_k], r7
    mov   r7, r6
.glyph:                                 ; glyph r7 at dp_ad (rows 1..5 of the page), then a blank column
    mov   r6, r7
    shl   r6, 1
    add   r6, r7
    li    r1, #dp_fnt
    add   r1, r6
    ld    r5, [r1+0]
    ld    r4, [r1+1]
    ld    r3, [r1+2]
    shl   r5, 1
    shl   r4, 1
    shl   r3, 1
    ld    r1, [dp_ad]
    st    [r1+0], r5
    st    [r1+1], r4
    st    [r1+2], r3
    mov   r7, #0
    st    [r1+3], r7
    add   r1, #4
    st    [dp_ad], r1
    ld    r7, [dp_k]                    ; next digit: divisor pairs (d, -d)
    cmp   r7, #5
    beq   .lnext
    mov   r6, r7
    shl   r6, 1
    li    r1, #dp_div
    add   r1, r6
    add   r7, #1
    st    [dp_k], r7
    ld    r6, [r1+0]
    ld    r4, [r1+1]
    ld    r5, [dp_v]
    mov   r7, #0
.dv:
    cmp   r7, #9                        ; at most 9 per digit, whatever the RAM holds
    beq   .dd
    cmp   r5, r6
    blt   .dd
    add   r5, r4
    add   r7, #1
    jmp   .dv
.dd:
    st    [dp_v], r5
    jmp   .glyph
.lnext:
    ld    r7, [dp_i]
    add   r7, #1
    st    [dp_i], r7
    cmp   r7, #5
    bne   .line
    ld    r7, [0x6a50]
    mov   r6, #1
    or    r7, r6
    st    [0x6a50], r7
    ret
dp_init:                                ; leaf: line table, divisor pairs and font into RAM dp_tab..
    mov   r7, #0x000a
    st    [0x6514], r7
    li    r7, #0x6503
    st    [0x6515], r7
    mov   r7, #0x000b
    st    [0x6516], r7
    li    r7, #0x6505
    st    [0x6517], r7
    mov   r7, #0x000c
    st    [0x6518], r7
    li    r7, #0x6506
    st    [0x6519], r7
    mov   r7, #0x000d
    st    [0x651a], r7
    li    r7, #0x6507
    st    [0x651b], r7
    mov   r7, #0x000e
    st    [0x651c], r7
    li    r7, #0x6560
    st    [0x651d], r7
    li    r7, #0x2710
    st    [0x651e], r7
    li    r7, #0xd8f0
    st    [0x651f], r7
    li    r7, #0x03e8
    st    [0x6520], r7
    li    r7, #0xfc18
    st    [0x6521], r7
    mov   r7, #0x0064
    st    [0x6522], r7
    li    r7, #0xff9c
    st    [0x6523], r7
    mov   r7, #0x000a
    st    [0x6524], r7
    li    r7, #0xfff6
    st    [0x6525], r7
    mov   r7, #0x0001
    st    [0x6526], r7
    li    r7, #0xffff
    st    [0x6527], r7
    mov   r7, #0x001f
