.patch battery_percent
.title "Battery in percent on the status bar instead of the bar icon (73%), from an adjustable discharge curve; on battery the number only goes down"
; The status bar ends with BPM's number at x 89..103; the stock battery is the lightning at x 107..111 and the
; icon at 112..125. draw_battery (hooked after its prologue) now clears x 104..127 and draws:
;   on battery   a 5x5 standing battery icon (filled by level), the percentage, right-aligned, and a 3x5 '%' (the small font has none)
;                at x 124..126: "[] 73%", 100% fills x 104..126
;   charging     the lightning against the icon and at most 99%; 100% (no lightning) once the charger reports
;                full (never seen in the telemetry log: charge_full stayed 0 at the 955 plateau)
;   power_src 0  (no battery seen at power-on) the stock full icon
; Low battery (batt_low): the stock code blinks the icon for 1400 ticks (14 s), then calls power_off. Hooked at its
; start: the same counter and times, the number blinks instead (1 s off, 1 s on), and at 1400 we jump to the
; stock power_off call (telemetry hooks that call).
;
; The curve: EMPTY is the reading of 0%, STEP1..STEP10 the span of each tenth (0-10%, 10-20%, .. 90-100%), so 100%
; is at EMPTY + STEP1 + .. + STEP10; within a tenth the percentage is linear. The curve is on the scale of a
; reading taken asleep: awake (backlight, amplifier, PLL) the reading is lower by an amount that grows with the
; charge (telemetry, 2026-10-17: about 4 up to 858, then a quarter of the excess, at most 16 near full; playing or
; not hardly matters), so awake SAG_LOW + (reading - SAG_KNEE) / 4, at most SAG_MAX, is added first. The steps
; come from a logged full discharge (2026-10-16: 42 h on battery from full, 87% of it asleep; percent of time on
; battery), 100% at 935 (awake right after a full charge, 917..921, plus the sag), 0% at 760 (the stock cut-off,
; 756 awake). While charging the reading is higher by about CHARGING (34 at the plug-in in the log; the stock
; thresholds add 0x12): taken off first. Asleep = extra_menu's sleep (its flag, valid with its magic); without it,
; always awake.
; On battery the shown value never goes up (a lighter load lets the voltage recover), and it stays as it is for
; SETTLE seconds after falling asleep or waking up (the averaged reading moves for a while); it starts afresh at
; power-on and after the charger is unplugged: for START seconds then it follows the reading both ways (the
; averaged reading starts low, and a first reading of 2% must not stay for the whole charge).
; The stock code redraws the battery when the ADC moved by more than 5 since the last drawing (about 3%);
; REDRAW lowers that.
;
; Code above 0xffff (far call, checked with far_test), past the end of the official file (it grows). Uses only r1, r6,
; r7 and RAM 0x6400..0x6424 (unused after init_all, see FINDINGS). Time comes from extra_menu's clock (bp_clk,
; every tick, its tm_dt), without it from battery_tick.
.param EMPTY 760 650 850 "Battery %: reading of 0%, asleep scale (stock low-battery threshold 756 awake)"
.param STEP1 23 0 50 "Battery %: span of 0-10%"
.param STEP2 16 0 50 "Battery %: span of 10-20%"
.param STEP3 12 0 50 "Battery %: span of 20-30%"
.param STEP4 10 0 50 "Battery %: span of 30-40%"
.param STEP5 11 0 50 "Battery %: span of 40-50%"
.param STEP6 13 0 50 "Battery %: span of 50-60%"
.param STEP7 16 0 50 "Battery %: span of 60-70%"
.param STEP8 24 0 50 "Battery %: span of 70-80%"
.param STEP9 27 0 50 "Battery %: span of 80-90%"
.param STEP10 23 0 50 "Battery %: span of 90-100%"
.param SAG_LOW 4 0 30 "Battery %: how much lower the reading is awake than asleep, at low charge"
.param SAG_KNEE 858 700 1000 "Battery %: from this reading (awake) the difference grows by a quarter of the excess"
.param SAG_MAX 16 0 40 "Battery %: the largest difference awake / asleep"
.param SETTLE 300 0 300 "Battery %: seconds the shown value stays after falling asleep or waking up"
.param START 60 0 300 "Battery %: seconds after power-on or unplugging during which the value may also go up"
.param CHARGING 34 0 80 "Battery %: how much higher the reading is with the charger plugged in"
.param REDRAW 2 1 5 "Battery %: redraw when the ADC moved by more than this (stock 5)"

; draw_battery, after `enter #2`: everything is ours, then its epilogue
.hook 0x055b4 expect 0xc14c 0x0000 0xc14c 0x00bd
    call  bp_draw
    .dw   0xd0ce, 0x5712
.end

; battery_tick, batt_low set: replaces the counter and the first blink case
.hook 0x00b35 expect 0xd148 0x001e 0xc790 0x1701 0xcf90 0x0f64 0xe00d 0x0500
    call  bp_blink
    cmp   r7, #0
    beq   .stay
    .dw   0xd0ce, 0x0c1c      ; time is up: the stock `ccall power_off`
.stay:
    .dw   0xd0ce, 0x0c1e      ; after the blink cases
.end

; battery_tick: redraw threshold (stock `mov r7, #5`)
.hook 0x00c6b expect 0x0705
    mov   r7, #REDRAW
.end

; battery_tick, every 32 calls (0.32 s awake, about 10 s asleep): the stock `mov r7, #0; st [r1+0], r7`
; (r1 = 0x001a); without extra_menu's clock the settle timer counts here
.hook 0x00c27 expect 0x0700 0xcf90
    call  bp_tick
.end

.code 0x1a280
.equ bp_a, 0x6400             ; 10 x the reading
.equ bp_b, 0x6401             ; 10 x the threshold of the next percent
.equ bp_val, 0x6402           ; the percentage
.equ bp_p, 0x6403             ; -> the step of the current tenth
.equ bp_j, 0x6404             ; percent within the tenth
.equ bp_last, 0x6405          ; the lowest value shown on battery
.equ bp_mag, 0x6406           ; 0x5aa4 starting (bp_last follows the value), 0x5aa5 never up
.equ bp_ph, 0x6407            ; blink phase drawn: 0 hidden, 1 shown
.equ bp_n, 0x6408             ; characters in bp_txt
.equ bp_x, 0x6409             ; x of the number
.equ bp_t, 0x640a             ; tens
.equ bp_u, 0x640b             ; units
.equ bp_ix, 0x640c            ; x of the battery icon
.equ bp_bolt, 0x640d          ; 1: draw the lightning (charging)
.equ bp_slp, 0x640e           ; asleep as last seen by bp_tick
.equ bp_hold, 0x640f          ; 10 ms since falling asleep or waking up (up to SETTLE s)
.equ sl_magic, 0x6a3f         ; extra_menu: 0xa55a once its sleep state (and its clock) is set up
.equ sl_on, 0x6a41            ; extra_menu: 1 asleep
.equ tm_dt, 0x63c1            ; extra_menu's clock: 10 ms per tick now (1, more asleep)
.equ bp_s, 0x6410             ; STEP1..STEP10
.equ bp_dtl, 0x641a           ; bp_clk: 10 ms gone this time
.equ bp_boot, 0x641b          ; 10 ms since starting (bp_mag 0x5aa4), up to START s
.equ bp_txt, 0x6420           ; the number, 0-terminated

bp_draw:
    push  #0
    push  #7
    push  #0x18
    push  #0
    push  #0x68
    ccall 0x04a69             ; clear x 104..127, y 0..6
    ld    r7, [power_src]
    cmp   r7, #0
    bne   .bat
    push  #0                  ; no battery at power-on: the stock full icon
    push  #0xbd
    push  #1
    push  #0x70
    ccall draw_glyph
    push  #1
    push  #3
    push  #0xa
    push  #2
    push  #0x71
    ccall 0x04a69
    ret
.bat:
    call  bp_pct
    mov   r7, #0
    st    [bp_bolt], r7
    ld    r7, [power_src]
    cmp   r7, #2
    bne   .txt
    ld    r7, [charge_full]
    cmp   r7, #1
    bne   .chg
    mov   r7, #100            ; charger reports full: 100%, no lightning (as the stock full icon)
    st    [bp_val], r7
    jmp   .txt
.chg:
    mov   r7, #1
    st    [bp_bolt], r7
    ld    r7, [bp_val]
    cmp   r7, #100
    blt   .txt
    mov   r7, #99
    st    [bp_val], r7
.txt:
    call  bp_text
    push  #1                  ; as BPM's number: spacing 1, small font, y 1
    push  #1
    push  #bp_txt
    push  #0
    push  #1
    ld    r7, [bp_x]
    push  r7
    ccall draw_text_impl
    push  #1                  ; '%': #.# / ..# / .#. / #.. / #.#
    push  #1
    push  #1
    push  #1
    push  #124
    ccall 0x04a69
    push  #1
    push  #2
    push  #1
    push  #1
    push  #126
    ccall 0x04a69
    push  #1
    push  #1
    push  #1
    push  #3
    push  #125
    ccall 0x04a69
    push  #1
    push  #2
    push  #1
    push  #4
    push  #124
    ccall 0x04a69
    push  #1
    push  #1
    push  #1
    push  #5
    push  #126
    ccall 0x04a69
    ld    r7, [bp_x]          ; battery icon left of the number, standing (a lying 5x5 one read as something else):
    li    r6, #-6             ; .###. / ##### / #...# / #...# / #####, inside filled from 34% (bottom), 67% (both)
    add   r7, r6
    st    [bp_ix], r7
    push  #1                  ; body, filled; the empty part is cleared below
    push  #4
    push  #5
    push  #2
    ld    r7, [bp_ix]
    push  r7
    ccall 0x04a69
    push  #1                  ; terminal
    push  #1
    push  #3
    push  #1
    ld    r7, [bp_ix]
    add   r7, #1
    push  r7
    ccall 0x04a69
    ld    r7, [bp_val]        ; empty rows inside, from the top: 2 below 34%, 1 below 67%, else none
    cmp   r7, #67
    blt   .lv1
    jmp   .lvdone
.lv1:
    push  #0
    cmp   r7, #34
    blt   .lv2
    push  #1
    jmp   .lvclr
.lv2:
    push  #2
.lvclr:
    push  #3
    push  #3
    ld    r7, [bp_ix]
    add   r7, #1
    push  r7
    ccall 0x04a69
.lvdone:
    ld    r7, [bp_bolt]
    cmp   r7, #0
    beq   .nobolt
    push  #0                  ; charging: the stock lightning (4x5), against the icon
    push  #0xc4
    push  #1
    ld    r7, [bp_ix]
    li    r6, #-4
    add   r7, r6
    push  r7
    ccall draw_glyph
.nobolt:
    ret

; batt_adc -> bp_val 0..100 along the curve
bp_pct:
    li    r7, #STEP1
    st    [bp_s], r7
    li    r7, #STEP2
    st    [bp_s+1], r7
    li    r7, #STEP3
    st    [bp_s+2], r7
    li    r7, #STEP4
    st    [bp_s+3], r7
    li    r7, #STEP5
    st    [bp_s+4], r7
    li    r7, #STEP6
    st    [bp_s+5], r7
    li    r7, #STEP7
    st    [bp_s+6], r7
    li    r7, #STEP8
    st    [bp_s+7], r7
    li    r7, #STEP9
    st    [bp_s+8], r7
    li    r7, #STEP10
    st    [bp_s+9], r7
    ld    r7, [batt_adc]
    ld    r6, [power_src]
    cmp   r6, #2
    bne   .adc
    li    r6, #-CHARGING      ; charging: the reading is higher
    add   r7, r6
.adc:
    st    [bp_a], r7
    call  bp_asleep
    cmp   r7, #0
    bne   .sg_scale              ; asleep: the curve's own scale
    ld    r7, [bp_a]          ; awake: + SAG_LOW + (reading - SAG_KNEE) / 4, at most SAG_MAX
    li    r6, #SAG_KNEE
    cmp   r7, r6
    blt   .sg_low
    li    r6, #-SAG_KNEE
    add   r7, r6
    shr   r7, 2
    jmp   .sg_addl
.sg_low:
    mov   r7, #0
.sg_addl:
    li    r6, #SAG_LOW
    add   r7, r6
    li    r6, #SAG_MAX
    cmp   r7, r6
    blt   .sg_sag
    mov   r7, r6
.sg_sag:
    ld    r6, [bp_a]
    add   r7, r6
    st    [bp_a], r7
.sg_scale:
    ld    r7, [bp_a]
    mov   r6, r7              ; x10
    shl   r7, 2
    add   r7, r6
    shl   r7, 1
    st    [bp_a], r7
    li    r7, #EMPTY*10
    st    [bp_b], r7
    mov   r7, #0
    st    [bp_val], r7
    ld    r6, [bp_a]
    ld    r7, [bp_b]
    cmp   r6, r7
    blt   .done               ; below EMPTY: 0%
    li    r7, #bp_s
    st    [bp_p], r7
.tenth:
    mov   r7, #0
    st    [bp_j], r7
.step:                        ; bp_b += the tenth's step; one more percent while the reading reaches it
    ld    r1, [bp_p]
    ld    r6, [r1+0]
    ld    r7, [bp_b]
    add   r7, r6
    st    [bp_b], r7
    ld    r6, [bp_a]
    cmp   r6, r7
    blt   .done
    ld    r7, [bp_val]
    add   r7, #1
    st    [bp_val], r7
    cmp   r7, #100
    beq   .done
    ld    r7, [bp_j]
    add   r7, #1
    st    [bp_j], r7
    cmp   r7, #10
    blt   .step
    ld    r7, [bp_p]
    add   r7, #1
    st    [bp_p], r7
    jmp   .tenth
.done:
    ld    r7, [power_src]
    cmp   r7, #1
    beq   .mono
    mov   r7, #0              ; charger or no battery: start afresh when back on battery
    st    [bp_mag], r7
    ret
.mono:
    ld    r7, [bp_mag]
    li    r6, #0x5aa5
    cmp   r7, r6
    beq   .min
    ld    r7, [batt_adc]
    li    r6, #400            ; no reading yet (stock: < 0x190 = no battery): nothing to remember
    cmp   r7, r6
    blt   .ret
    ld    r7, [bp_mag]
    li    r6, #0x5aa4
    cmp   r7, r6
    beq   .start
    st    [bp_mag], r6        ; starting: bp_clk makes it 0x5aa5 after START s
    mov   r7, #0
    st    [bp_boot], r7
.start:
    ld    r7, [bp_val]
    st    [bp_last], r7
.ret:
    ret
.min:
    ld    r6, [bp_last]
    ld    r7, [batt_adc]
    li    r1, #400
    cmp   r7, r1
    blt   .keep               ; no reading: the last value
    ld    r7, [bp_hold]
    li    r1, #SETTLE*100
    cmp   r7, r1
    blt   .keep               ; just fell asleep or woke up: the last value
    ld    r7, [bp_val]
    cmp   r6, r7
    blt   .keep
    st    [bp_last], r7
    ret
.keep:
    st    [bp_val], r6        ; never up on battery
    ret

; r7 = 1 asleep (extra_menu's sleep), else 0
bp_asleep:
    ld    r7, [sl_magic]
    li    r6, #0xa55a
    cmp   r7, r6
    bne   .as_no
    ld    r7, [sl_on]
    cmp   r7, #1
    bne   .as_no
    ret
.as_no:
    mov   r7, #0
    ret

; battery_tick every 32 calls: the replaced stock instructions; without extra_menu's clock (nothing sleeps
; then) the settle timer goes on by those 32 ticks
bp_tick:
    mov   r7, #0
    st    [r1+0], r7
    ld    r7, [sl_magic]
    li    r6, #0xa55a
    cmp   r7, r6
    beq   .tk_out
    mov   r7, #32
    jmp   bp_clk
.tk_out:
    ret

; r7 = 1, or extra_menu's tm_dt (10 ms per tick)
bp_dt:
    ld    r7, [sl_magic]
    li    r6, #0xa55a
    cmp   r7, r6
    bne   .dt_one
    ld    r7, [tm_dt]
    ret
.dt_one:
    mov   r7, #1
    ret

; every tick from extra_menu's clock (or bp_tick), r7 = 10 ms gone: the start timer, and the settle timer counts
; up from a change of asleep / awake to SETTLE s. Keeps r7; uses r6.
bp_clk:
    st    [bp_dtl], r7
    ld    r7, [bp_mag]        ; starting: never up from START s on
    li    r6, #0x5aa4
    cmp   r7, r6
    bne   .tk_hold
    ld    r7, [bp_boot]
    ld    r6, [bp_dtl]
    add   r7, r6
    st    [bp_boot], r7
    li    r6, #START*100
    cmp   r7, r6
    blt   .tk_hold
    li    r7, #0x5aa5
    st    [bp_mag], r7
.tk_hold:
    call  bp_asleep
    ld    r6, [bp_slp]
    cmp   r6, r7
    beq   .tk_same
    st    [bp_slp], r7
    mov   r7, #0
    jmp   .tk_st
.tk_same:
    ld    r7, [bp_hold]
    ld    r6, [bp_dtl]
    add   r7, r6
    cmp   r7, #0              ; RAM is not cleared at power-on: at most a full settle
    blt   .tk_cap
    li    r6, #SETTLE*100
    cmp   r7, r6
    blt   .tk_st
.tk_cap:
    li    r7, #SETTLE*100
.tk_st:
    st    [bp_hold], r7
    ld    r7, [bp_dtl]
    ret

; bp_val -> bp_txt, bp_x = 124 - its width (draw_text_impl advances 5 per digit, 4 after a '1')
bp_text:
    mov   r6, #0
    st    [bp_n], r6
    mov   r6, #124
    st    [bp_x], r6
    ld    r7, [bp_val]
    cmp   r7, #100
    blt   .tens
    mov   r7, #1
    call  bp_dig
    mov   r7, #0
    call  bp_dig
    mov   r7, #0
    call  bp_dig
    jmp   .end
.tens:
    mov   r6, #0
    st    [bp_t], r6
.t:
    cmp   r7, #10
    blt   .u
    li    r6, #-10
    add   r7, r6
    ld    r6, [bp_t]
    add   r6, #1
    st    [bp_t], r6
    jmp   .t
.u:
    st    [bp_u], r7
    ld    r7, [bp_t]
    cmp   r7, #0
    beq   .one
    call  bp_dig
.one:
    ld    r7, [bp_u]
    call  bp_dig
.end:
    ld    r1, [bp_n]
    addi  r1, #bp_txt
    mov   r7, #0
    st    [r1+0], r7
    ret

; r7 = a digit: appended to bp_txt, bp_x moved left by its advance
bp_dig:
    ld    r1, [bp_n]
    addi  r1, #bp_txt
    mov   r6, r7
    add   r6, #0x30
    st    [r1+0], r6
    ld    r6, [bp_n]
    add   r6, #1
    st    [bp_n], r6
    li    r6, #-5
    cmp   r7, #1
    bne   .w
    li    r6, #-4
.w:
    ld    r7, [bp_x]
    add   r7, r6
    st    [bp_x], r7
    ret

; batt_low, every tick: the stock counter 0x1e; 1 s hidden, 1 s shown; r7 = 1 at 14 s (power off)
bp_blink:
    call  bp_dt               ; the stock counter, in 10 ms here (asleep a tick is longer)
    ld    r6, [0x001e]
    add   r7, r6
    st    [0x001e], r7
    li    r6, #1400
    cmp   r7, r6
    blt   .on
    mov   r7, #1
    ret
.on:
    li    r6, #-200
.mod:
    cmp   r7, #200
    blt   .ph
    add   r7, r6
    jmp   .mod
.ph:
    mov   r6, #0
    cmp   r7, #100
    blt   .p
    mov   r6, #1
.p:
    ld    r7, [bp_ph]
    cmp   r7, r6
    beq   .same               ; draw only when the phase changes
    st    [bp_ph], r6
    cmp   r6, #0
    beq   .hide
    call  bp_draw
    jmp   .same
.hide:
    push  #0
    push  #7
    push  #0x18
    push  #0
    push  #0x68
    ccall 0x04a69
.same:
    mov   r7, #0
    ret
.end
