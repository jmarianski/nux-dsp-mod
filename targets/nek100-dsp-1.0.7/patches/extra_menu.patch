; ---- Backlight (screen 24): bits 6-8 of presets_header, the dial changes it, the left key goes back
bl_screen:
    .dw   0x830d, 0x2b01
    ld    r7, [fp+0]
    push  r7
    ld    r7, [fp+3]
    .dw   0x2f07
    push  r7
    ccall 0x0584f             ; header (ex_head) and battery
    push  #0x6                ; BACK
    push  #0
    push  #0
    ccall draw_softkey
    push  #0
    push  #0xb7
    push  #0x1e
    push  #6
    ccall draw_glyph
    push  #0
    push  #0xba
    push  #0x1e
    push  #118
    ccall draw_glyph
    call  ex_norm             ; (makes sure the word is ours)
    ld    r7, [presets_header]
    shr   r7, 6
    and   r7, #7
    mov   r5, r7              ; 12 words a name
    shl   r5, 3
    mov   r6, r7
    shl   r6, 2
    add   r5, r6
    addi  r5, #bl_names
    ld    r6, [0x0168]        ; lang_pl: Polish names, 96 words further
    cmp   r6, #0x47
    beq   .bl_en
    add   r5, #96
.bl_en:
    call  ex_copy
    mov   r7, #0
    push  r7
    push  #0x10
    push  #106
    push  #0x19
    push  #11
    ccall 0x04a69             ; clear the value area
    mov   r7, #0
    push  #text_buf
    push  r7
    push  #1
    push  r7
    push  #0x1b
    push  #64
    ccall draw_text_centered
    .dw   0xd0ce, 0x061f5

bl_names:                     ; 12 words each, English then Polish
    .dw   0x41, 0x4c, 0x57, 0x41, 0x59, 0x53, 0x20, 0x4f, 0x46, 0x46, 0, 0   ; ALWAYS OFF
    .dw   0x35, 0x20, 0x53, 0, 0, 0, 0, 0, 0, 0, 0, 0   ; 5 S
    .dw   0x31, 0x30, 0x20, 0x53, 0, 0, 0, 0, 0, 0, 0, 0   ; 10 S
    .dw   0x31, 0x35, 0x20, 0x53, 0, 0, 0, 0, 0, 0, 0, 0   ; 15 S
    .dw   0x33, 0x30, 0x20, 0x53, 0, 0, 0, 0, 0, 0, 0, 0   ; 30 S
    .dw   0x31, 0x20, 0x4d, 0x49, 0x4e, 0, 0, 0, 0, 0, 0, 0   ; 1 MIN
    .dw   0x35, 0x20, 0x4d, 0x49, 0x4e, 0, 0, 0, 0, 0, 0, 0   ; 5 MIN
    .dw   0x41, 0x4c, 0x57, 0x41, 0x59, 0x53, 0x20, 0x4f, 0x4e, 0, 0, 0   ; ALWAYS ON
    .dw   0x5a, 0x41, 0x57, 0x53, 0x5a, 0x45, 0x20, 0x57, 0x59, 0x141, 0, 0   ; ZAWSZE WYŁ
    .dw   0x35, 0x20, 0x53, 0, 0, 0, 0, 0, 0, 0, 0, 0   ; 5 S
    .dw   0x31, 0x30, 0x20, 0x53, 0, 0, 0, 0, 0, 0, 0, 0   ; 10 S
    .dw   0x31, 0x35, 0x20, 0x53, 0, 0, 0, 0, 0, 0, 0, 0   ; 15 S
    .dw   0x33, 0x30, 0x20, 0x53, 0, 0, 0, 0, 0, 0, 0, 0   ; 30 S
    .dw   0x31, 0x20, 0x4d, 0x49, 0x4e, 0, 0, 0, 0, 0, 0, 0   ; 1 MIN
    .dw   0x35, 0x20, 0x4d, 0x49, 0x4e, 0, 0, 0, 0, 0, 0, 0   ; 5 MIN
    .dw   0x5a, 0x41, 0x57, 0x53, 0x5a, 0x45, 0x20, 0x57, 0x141, 0, 0, 0   ; ZAWSZE WŁ

bl_limits:                    ; ticks (10 ms) without the panel; 0 and 7 are not looked up
    .dw   0, 500, 1000, 1500, 3000, 6000, 30000, 0

bl_dial:                      ; dial: setting -1 / +1, clamp 0..7, save to flash
    .dw   0xd2cd, 0x0002      ; r5 = dial delta, signed
    cmp   r5, #0
    beq   .bd_out
    shr   r5, 15              ; 1 = turned down
    call  ex_norm
    ld    r7, [presets_header]
    mov   r6, r7
    shr   r6, 6
    and   r6, #7
    cmp   r5, #0
    bne   .bd_down
    cmp   r6, #7
    beq   .bd_out
    add   r6, #1
    jmp   .bd_set
.bd_down:
    cmp   r6, #0
    beq   .bd_out
    li    r5, #0xffff
    add   r6, r5
.bd_set:
    li    r5, #0xfe3f
    and   r7, r5
    shl   r6, 6
    or    r7, r6
    st    [presets_header], r7
    push  #presets_header
    ccall flash_write_words
    ld    r7, [screen]
    push  r7
    ccall draw_screen
.bd_out:
    .dw   0xd0ce, 0x03b5f

; tick_10ms (0x0830, after the outputs): backlight on or off as the setting and bl_count say. Ends with
; r1 = 0x0117, as the instruction it replaces. Reads presets_header only (the menu code may be halfway
; through ex_norm / ex_put). Before boot_presets has read the settings the word is not ours: on.
bl_tick:
    ld    r7, [presets_header]
    mov   r6, r7
    shr   r6, 12
    cmp   r6, #0xb
    bne   .l_on
    li    r6, #0x0200
    and   r6, r7
    cmp   r6, #0
    beq   .l_on
    shr   r7, 6
    and   r7, #7
    cmp   r7, #7
    beq   .l_on
    cmp   r7, #0
    beq   .l_off
    mov   r1, r7
    addi  r1, #bl_limits
    ldc   r7, [r1+0]
    ld    r6, [bl_count]
    cmp   r6, r7
    blt   .l_count
    jmp   .l_off
.l_count:
    add   r6, #1
    st    [bl_count], r6
.l_on:
    .dw   0x00e7, 0xd0cc, 0x1000   ; port 0xe7 |= 0x1000
    li    r1, #0x0117
    ret
.l_off:
    .dw   0x00e7, 0xd0cd, 0xefff   ; port 0xe7 &= ~0x1000
    li    r1, #0x0117
    ret

; key_event and the dial's handler (0x391a), where they zero idle_ticks: the backlight comes back
bl_wake:
    mov   r1, #0
    st    [bl_count], r1
    li    r1, #0x000b
    ret

; tick_10ms (0x0821): r7 = the welcome counter; 0 switches the outputs on. amp_cnt counts ticks since the
; last message to the synthesizer (amp_note), whoever sent it: keys, accompaniment, demo, metronome, USB.
; After AMP_IDLE_SECS of both that and idle_ticks: outputs off and r7 = 1, so the stock code leaves them
; alone this tick.
amp_chk:
    ld    r6, [amp_cnt]
    li    r7, #30000
    cmp   r6, r7
    blt   .m_inc
    jmp   .m_test
.m_inc:
    add   r6, #1
    st    [amp_cnt], r6
.m_test:
    li    r7, #(AMP_IDLE_SECS * 50)   ; half the ticks, so it stays positive
    cmp   r7, #0
    beq   .m_stock
    ld    r6, [idle_ticks]    ; high word
    cmp   r6, #0
    bne   .m_synth
    ld    r6, [idle_ticks+1]
    shr   r6, 1
    cmp   r6, r7
    blt   .m_stock
.m_synth:
    ld    r6, [amp_cnt]
    shr   r6, 1
    cmp   r6, r7
    blt   .m_stock
    .dw   0x00e0, 0xd0cd, 0xefff   ; port 0xe0 &= ~0x1000 (C: not enough on its own, the speaker hissed on)
    .dw   0xd0cd, 0xfeff           ; and ~0x100 (H: speaker amplifier; on unless headphones), as power_off
    mov   r7, #1
    ret
.m_stock:
    ld    r7, [0x0011]
    ret

; the synthesizer's MIDI input (0x0d6d0, the library's; synth_send and many others call it): a message
amp_note:
    mov   r7, #0
    st    [amp_cnt], r7
    and   r4, #1
    mov   r7, #0xd
    ret

; ---- images 0x100.. : draw_glyph(x, y, id, inverse) for our ids, from program memory.
; Format: W, H, then per column ceil(H / 16) words, MSB = top row. Frame locals of draw_glyph:
; [fp+0] column, [fp+1] data pointer, [fp+2] W, [fp+3] bits, [fp+4] H, [fp+5] row.
ao_glyph:
    .dw   0x830d, 0x2b07
    ld    r7, [fp+11]
    li    r6, #0x100
    cmp   r7, r6
    blt   .q_stock
    li    r6, #0xff00
    add   r7, r6
    ld    r6, [0x0168]        ; lang_pl: the Polish table
    cmp   r6, #0x47
    beq   .q_en
    add   r7, #15
.q_en:
    mov   r1, r7
    addi  r1, #ao_images
    ldc   r7, [r1+0]
    mov   r1, r7
    ldc   r6, [r1+0]
    st    [fp+2], r6
    ldc   r6, [r1+1]
    st    [fp+4], r6
    add   r7, #2
    st    [fp+1], r7
    mov   r7, #0
    st    [fp+0], r7
.q_col:
    ld    r7, [fp+0]
    ld    r6, [fp+2]
    cmp   r7, r6
    blt   .q_col_go
    .dw   0xd0ce, 0x04a3b     ; draw_glyph's epilogue
.q_col_go:
    mov   r7, #0
    st    [fp+5], r7
.q_row:
    ld    r7, [fp+5]
    ld    r6, [fp+4]
    cmp   r7, r6
    blt   .q_row_go
    ld    r7, [fp+0]          ; next column; its words start on a new word
    add   r7, #1
    st    [fp+0], r7
    jmp   .q_col
.q_row_go:
    and   r7, #15
    cmp   r7, #0
    bne   .q_bit
    ld    r1, [fp+1]
    ldc   r7, [r1+0]
    st    [fp+3], r7
    ld    r7, [fp+1]
    add   r7, #1
    st    [fp+1], r7
.q_bit:
    ld    r7, [fp+3]
    mov   r6, r7
    shl   r6, 1
    st    [fp+3], r6
    shr   r7, 15
    ld    r6, [fp+12]
    cmp   r6, #0
    beq   .q_put
    li    r6, #0xffff         ; inverse: 1 - bit
    add   r7, r6
    and   r7, #1
.q_put:
    push  r7
    ld    r7, [fp+9]
    ld    r6, [fp+0]
    add   r7, r6
    push  r7
    ld    r7, [fp+10]
    ld    r6, [fp+5]
    add   r7, r6
    push  r7
    ccall lcd_set_pixel
    .dw   0x830d, 0x2b07
    ld    r7, [fp+5]
    add   r7, #1
    st    [fp+5], r7
    jmp   .q_row
.q_stock:
    mov   r7, #7
    st    [fp+6], r7
    .dw   0xd0ce, 0x04971

