.patch extra_menu

.title "Extra menu in place of Info: Auto Off (separate battery and cable times), Startup (Default preset, autosave or factory settings), Backlight (off after 5 s..5 min without the panel, or always on / off), the list of installed patches, Info"
; The function menu keeps its 12 items; the last one (Info) becomes Extra, a page of five:
;   Auto Off  screen 21: power-off time on battery and on cable (Off, 5..120 min)
;   Startup   screen 23: what is loaded at power-on (see below)
;   Backlight screen 24: the LCD backlight goes off after that long without a panel key or the dial (playing
;             does not count), back on with the next one; or always off, or always on (stock)
;   Patches   screen 22: which patches of this project are in the firmware (found by looking at their words)
;   Info      the stock screen 19; its Back key now returns to Extra
; Extra itself is screen 20. Screens 20..24 are reached through hooks in front of the range checks of
; draw_screen and the key dispatchers (A, B, D, dial); their images (ids 0x100 and up) are drawn by our
; own blitter from program memory, hooked into draw_glyph.
;
; Auto Off. Stock: power_key_poll switches off after 180000 ticks (30 min) of idle_ticks, and battery_tick
; zeroes idle_ticks every tick while the charger is plugged, so on cable the instrument never switches off.
; Here the zeroing is gone and the limit comes from the settings word:
;   presets_header[0]  0xB in the top 4 bits when set by us (stock flash holds 1 -> defaults)
;                      bits 0-2 battery time, bits 3-5 cable time (0 = Off, 5, 10, 15, 30, 60, 90, 120 min),
;                      bits 6-8 Backlight (0 always off, 5 s, 10 s, 15 s, 30 s, 1 min, 5 min, 7 always on),
;                      bit 9 set (this layout; before it, bits 6-9 held the menu state: then Backlight = on),
;                      bits 10-11 Startup mode
; The menu state lives in RAM (ex_ui: bit 6 which time the Auto Off screen edits, bits 7-9 Extra cursor;
; ex_pg: Patches page). ex_norm returns the settings with ex_ui's bits in 6-9, ex_put stores such a word
; back; the Backlight code reads bits 6-8 of presets_header itself. RAM words 0x6a45..0x6a4b: the end of
; text_buf's area, which nothing in the firmware addresses (H: text_buf is 30 words, labels use at most 21).
; The firmware reads that word from flash at power-on and writes it back with every preset load, but
; never uses it. Defaults: battery 30 min (as stock), cable Off (as stock). power_src 0 counts as cable.
;
; Startup. 0 Default: as without this setting (the preset boot_preset loads, or the factory default).
; 1 Autosave: switching off with the power key or by Auto Off first saves the current settings to a hidden
; seventh flash page (0x706, next to the header 0x700 and the presets 0x701..0x705, in the same erase block;
; nothing else in the firmware touches that flash), and power-on loads them from there (when the page holds a
; preset; the Sustain key's state, no preset field, rides along in bit 7 of field 12). Not on low battery:
; the instrument may die while the page is being written. 2 Factory: power-on loads the factory default, as
; the stock firmware. With Autosave boot_preset names the presets User1..User5
; again, as none of them is the start preset. The settings travel through User5's RAM copy (user_presets + 124):
; at power-off it is not needed any more, at power-on it is read back from flash right after.
; The panel's factory reset puts all of this back: the stock code writes the factory header (Auto Off and
; Startup defaults), fr_wipe erases the Autosave page.
;
; Backlight: port 0xe7 bit 0x1000 (C: on hardware; set by the LCD init after the first screen, cleared by
; power_off). tick_10ms counts bl_count up to the limit and keeps the pin on below it, off at it; key_event
; (every panel key) and the dial's handler 0x391a zero bl_count; the keyboard does not. The key that wakes it also does its job.
;
; AMP_IDLE_SECS (no menu: no bits left in the settings word; 0 = never; C: on hardware with the metronome, demo,
; accompaniment): tick_10ms switches the outputs on every tick once the welcome
; counter is 0: port 0xe0 bit 0x1000 and bit 0x100 = [0x0005] (H: speaker amplifier, off with headphones).
; After that many seconds of idle_ticks (zeroed by keys, panel and MIDI from the MCU) and without any
; message to the synthesizer (amp_cnt: accompaniment, demo, metronome too) we skip that and clear both, as
; power_off does; the next note brings them back within a tick.
;
; With lang_pl (found by its first changed word, RAM 0x168 'G' -> 'F') headers, keys and texts are Polish.
;
; Images (the Polish ones are drawn with nuxdsp/pixfont.py, as lang_pl's):
; 0x100 ex_g_extra
; 0x101 ex_g_head_extra
; 0x102 ex_g_head_auto
; 0x103 ex_g_head_patch
; 0x104 ao_g_icon
; 0x105 ex_g_piece
; 0x106 ao_g_big
; 0x107 ao_g_batt
; 0x108 ao_g_batt_hi
; 0x109 ao_g_cable
; 0x10a ao_g_cable_hi
; 0x10b st_g_icon
; 0x10c st_g_head
; 0x10d bl_g_icon
; 0x10e bl_g_head

.param BATT_DEFAULT 4 0 7 "Battery time when not set yet: 0 Off, 1 5 min, 2 10, 3 15, 4 30, 5 60, 6 90, 7 120 min"
.param CABLE_DEFAULT 0 0 7 "Cable time when not set yet (same values)"
.param AMP_IDLE_SECS 60 0 300 "Switch the speaker amplifier off after this many seconds without anything to play (0 = never; H: port 0xe0 bits 0x1000, 0x100)"

.hook 0x009a4 expect 0xfbf1 0xbf20 0x0002 0xd148 0x000b 0xfa81 0xfaf7 0xfa13 0xe102 0xd7c8 0x0948  ; idle_ticks >= 180000 -> power_off
    .dw   0xd0ce, ao_due
    .dw   0x7800, 0x7800, 0x7800, 0x7800, 0x7800, 0x7800, 0x7800, 0x7800, 0x7800
.end

.hook 0x009a2 expect 0xd7c8 0x0948     ; power key held 50 ticks -> power_off
    .dw   0xd0ce, st_off_key
.end

.hook 0x02602 expect 0xd5c8 0xffff     ; end of boot_presets (presets read, start preset loaded)
    .dw   0xd0ce, st_boot
.end

.hook 0x025dc expect 0xd7c8 0x24f9     ; presets_factory_reset: factory presets written, header read next
    .dw   0xd0ce, fr_wipe
.end

.hook 0x00830 expect 0xd148 0x0117     ; tick_10ms, after the outputs: ldi r1, 0x0117
    call  bl_tick
.end

.hook 0x00821 expect 0xff80 0x0011     ; tick_10ms: ld r7, [welcome counter]; outputs on when 0
    call  amp_chk
.end

.hook 0x03860 expect 0xd148 0x000b     ; key_event: ldi r1, idle_ticks (zeroed next)
    call  bl_wake
.end

.hook 0x0391b expect 0xd148 0x000b     ; the dial's handler, same
    call  bl_wake
.end

.hook 0x0d6d3 expect 0x1c01 0x070d     ; the synthesizer's MIDI input (library, all callers): and r4, #1; mov r7, #0xd
    call  amp_note
.end

.hook 0x00b15 expect 0xfb63 0xd148 0x000b 0xce91 0xcf90   ; battery_tick on cable: idle_ticks = 0
    .dw   0x7800, 0x7800, 0x7800, 0x7800, 0x7800
.end

; function menu (screen 7): item 11 (Info) becomes Extra
.hook 0x05b0f expect 0xd14a 0xe357 0xd790 0x1701   ; list: small icon of item r1
    call  ex_icon
    .dw   0x7800, 0x7800
.end
.hook 0x05b2a expect 0xd148 0x0114 0xc190 0x1101 0xd14a 0xe363 0xd790   ; menu header
    call  ex_head
    .dw   0x7800, 0x7800, 0x7800, 0x7800, 0x7800
.end
.hook 0x05b67 expect 0xd148 0x0114 0xc190 0x1101 0xd14a 0xe363 0xd790   ; same, when only the row changed
    call  ex_head
    .dw   0x7800, 0x7800, 0x7800, 0x7800, 0x7800
.end
.hook 0x0585f expect 0xd148 0x0114 0xc190 0x1101 0xd14a 0xe363 0xd790   ; same, on the item screens
    call  ex_head
    .dw   0x7800, 0x7800, 0x7800, 0x7800, 0x7800
.end
.hook 0x0e08b expect 0x34bd     ; Enter on screen 7
    .dw   ex_menu_enter
.end
.hook 0x0e064 expect 0x313e     ; Back on screen 19 (Info)
    .dw   ex_info_back
.end

; screens 20..22
.hook 0x05c7a expect 0x0413 0xd2c9 0x0002 0x8c01 0xe002 0xd0ce 0x61f5   ; draw_screen: screen range check
    .dw   0xd0ce, ex_draw
    .dw   0x7800, 0x7800, 0x7800, 0x7800, 0x7800
.end
.hook 0x03023 expect 0x0413 0x8c01 0xfce7 0x0125   ; key A (left): range check of the screen table
    .dw   0xd0ce, ex_key_a
    .dw   0x7800, 0x7800
.end
.hook 0x0315e expect 0x0411 0x8c01 0xfce7 0x0212   ; key B (middle)
    .dw   0xd0ce, ex_key_b
    .dw   0x7800, 0x7800
.end
.hook 0x03420 expect 0x0413 0x8c01 0xfce7 0x0281   ; key D (right)
    .dw   0xd0ce, ex_key_d
    .dw   0x7800, 0x7800
.end
.hook 0x0398e expect 0x0412 0x8c01 0xfce7 0x01cd   ; dial
    .dw   0xd0ce, ex_key_f
    .dw   0x7800, 0x7800
.end
.hook 0x0496d expect 0x0707 0x830d 0x2b07 0xcfb6   ; draw_glyph: ids >= 0x100 are ours
    .dw   0xd0ce, ao_glyph
    .dw   0x7800, 0x7800
.end

.code
; make sure presets_header[0] holds our settings (defaults when the flash holds something else); r7 = it.
; Leaf, uses r6.
; With ex_ui's bits in 6-9 (the menu state, see the top). Leaf, uses r6 and ex_tmp.
.equ amp_cnt, 0x6a45
.equ ex_ui, 0x6a46
.equ ex_pg, 0x6a47
.equ ex_tmp, 0x6a48
.equ ex_tmp2, 0x6a49
.equ bl_count, 0x6a4b
ex_norm:
    ld    r7, [presets_header]
    mov   r6, r7
    shr   r6, 12
    cmp   r6, #0xb
    beq   .n_b
    li    r7, #0xb3c0         ; defaults, Backlight always on, this layout
    add   r7, #BATT_DEFAULT
    add   r7, #(CABLE_DEFAULT * 8)
    jmp   .n_store
.n_b:
    li    r6, #0x0200
    and   r6, r7
    cmp   r6, #0
    bne   .n_view
    li    r6, #0xfc3f         ; the layout before Backlight: bits 6-9 held the menu state
    and   r7, r6
    li    r6, #0x03c0
    or    r7, r6
.n_store:
    st    [presets_header], r7
.n_view:
    li    r6, #0xfc3f
    and   r7, r6
    st    [ex_tmp], r7
    ld    r7, [ex_ui]
    li    r6, #0x03c0
    and   r7, r6
    ld    r6, [ex_tmp]
    or    r7, r6
    ret

; store r7 (settings as ex_norm returns them): bits 6-9 to ex_ui, the rest to presets_header (keeping its
; bits 6-9). Keeps r7, uses r6.
ex_put:
    st    [ex_tmp], r7
    li    r6, #0x03c0
    and   r7, r6
    st    [ex_ui], r7
    ld    r7, [presets_header]
    and   r7, r6
    st    [ex_tmp2], r7
    ld    r7, [ex_tmp]
    li    r6, #0xfc3f
    and   r7, r6
    ld    r6, [ex_tmp2]
    or    r7, r6
    st    [presets_header], r7
    ld    r7, [ex_tmp]
    ret

; from power_key_poll (its frame): idle_ticks >= limit -> power_off
ao_due:
    call  ex_norm
    ld    r6, [power_src]
    cmp   r6, #1
    beq   .d_batt
    shr   r7, 3
.d_batt:
    and   r7, #7
    cmp   r7, #0
    beq   .d_no
    shl   r7, 1
    mov   r1, r7
    addi  r1, #ao_limits
    ldc   r7, [r1+0]          ; limit, high word
    ld    r6, [idle_ticks]    ; high word first (H: [0xb] = high, [0xc] = low)
    cmp   r6, r7
    blt   .d_no
    bne   .d_off
    ldc   r7, [r1+1]          ; same high word: compare the low words, halved so they stay positive
    shr   r7, 1
    ld    r6, [idle_ticks+1]
    shr   r6, 1
    cmp   r6, r7
    blt   .d_no
.d_off:
    mov   r7, #1
    .dw   0xd0ce, st_off
.d_no:
    .dw   0xd0ce, 0x009af

ao_limits:                    ; ticks (10 ms): minutes * 6000, high word then low word
    .dw   0x0000, 0x0000      ; Off
    .dw   0x0000, 0x7530      ; 5 min
    .dw   0x0000, 0xea60      ; 10
    .dw   0x0001, 0x5f90      ; 15
    .dw   0x0002, 0xbf20      ; 30 (stock)
    .dw   0x0005, 0x7e40      ; 60
    .dw   0x0008, 0x3d60      ; 90
    .dw   0x000a, 0xfc80      ; 120

; ---- function menu
; r1 = item -> r7 = its small icon
ex_icon:
    mov   r7, r1
    cmp   r7, #11
    bne   .i_stock
    li    r7, #0x100
    ret
.i_stock:
    addi  r1, #0xe357
    ldc   r7, [r1+0]
    add   r7, #1
    ret

; r7 = header image for the current screen / menu item (keeps r5). As in the stock menu, Extra shows
; the name of the item under the cursor, so the item screens find the right header already there.
ex_head:
    ld    r7, [screen]
    cmp   r7, #20
    bne   .h_21
    ld    r7, [ex_ui]         ; Extra: cursor in bits 7-9 (r6 may be in use here: no ex_norm)
    shr   r7, 7
    and   r7, #7
    li    r1, #0x102
    cmp   r7, #0
    beq   .h_ours
    li    r1, #0x10c
    cmp   r7, #1
    beq   .h_ours
    li    r1, #0x10e
    cmp   r7, #2
    beq   .h_ours
    li    r1, #0x103
    cmp   r7, #3
    beq   .h_ours
    jmp   .h_stock            ; Info
.h_21:
    li    r1, #0x102
    cmp   r7, #21
    beq   .h_ours
    li    r1, #0x103
    cmp   r7, #22
    beq   .h_ours
    li    r1, #0x10c
    cmp   r7, #23
    beq   .h_ours
    li    r1, #0x10e
    cmp   r7, #24
    beq   .h_ours
    cmp   r7, #19
    beq   .h_stock            ; Info keeps its own (item 11)
    li    r1, #0x101
    ld    r7, [0x0114]
    cmp   r7, #11
    beq   .h_ours
.h_stock:
    ld    r1, [0x0114]
    add   r1, #1
    addi  r1, #0xe363
    ldc   r7, [r1+0]
    ret
.h_ours:
    mov   r7, r1
    ret

; Enter on screen 7: item 11 opens Extra, the others as stock
ex_menu_enter:
    ld    r7, [0x0114]
    cmp   r7, #11
    beq   .e_extra
    .dw   0xd0ce, 0x034bd
.e_extra:
    mov   r7, #20
    st    [screen], r7
    st    [0x0113], r7        ; last drawn screen = this one: draw_screen clears all and redraws the header
    push  r7
    ccall draw_screen
    mov   r7, #0
    st    [0x0116], r7        ; as the stock Enter
    .dw   0xd0ce, 0x036a5

; Back on Info: to Extra
ex_info_back:
    mov   r7, #0
    st    [0x6a4d], r7        ; Info page
    mov   r7, #20
    st    [screen], r7
    push  r7
    ccall draw_screen
    .dw   0xd0ce, 0x0314c

; ---- dispatch. draw_screen: r1 = screen
ex_draw:
    .dw   0xd2c9, 0x0002
    mov   r4, #20
    cmp   r1, r4
    bne   .s_21
    .dw   0xd0ce, ex_scr_extra
.s_21:
    mov   r4, #21
    cmp   r1, r4
    bne   .s_22
    .dw   0xd0ce, ao_screen
.s_22:
    mov   r4, #22
    cmp   r1, r4
    bne   .s_23
    .dw   0xd0ce, pp_screen
.s_23:
    mov   r4, #23
    cmp   r1, r4
    bne   .s_24
    .dw   0xd0ce, st_screen
.s_24:
    mov   r4, #24
    cmp   r1, r4
    bne   .s_stock
    .dw   0xd0ce, bl_screen
.s_stock:
    mov   r4, #0x13
    cmp   r4, r1
    blt   .s_none
    .dw   0xd0ce, 0x05c81
.s_none:
    .dw   0xd0ce, 0x061f5

; keys: r1 = screen. Screens 20..22 go to us, the rest to the stock range check and table.
ex_key_a:
    mov   r4, #20
    cmp   r1, r4
    bne   .a_21
    .dw   0xd0ce, ex_back_menu
.a_21:
    mov   r4, #21
    cmp   r1, r4
    bne   .a_22
    .dw   0xd0ce, ao_batt
.a_22:
    mov   r4, #22
    cmp   r1, r4
    bne   .a_23
    .dw   0xd0ce, ex_back_a
.a_23:
    mov   r4, #23
    cmp   r1, r4
    bne   .a_24
    .dw   0xd0ce, ex_back_a
.a_24:
    mov   r4, #24
    cmp   r1, r4
    bne   .a_stock
    .dw   0xd0ce, ex_back_a
.a_stock:
    mov   r4, #0x13
    cmp   r4, r1
    blt   .a_out
    .dw   0xd0ce, 0x03027
.a_out:
    .dw   0xd0ce, 0x0314c

ex_key_b:
    mov   r4, #20
    cmp   r1, r4
    bne   .b_21
    .dw   0xd0ce, ex_next
.b_21:
    mov   r4, #21
    cmp   r1, r4
    bne   .b_22
    .dw   0xd0ce, ao_cable
.b_22:
    mov   r4, #22
    cmp   r1, r4
    beq   .b_out              ; Patches: nothing
    mov   r4, #0x11
    cmp   r4, r1
    blt   .b_out
    .dw   0xd0ce, 0x03162
.b_out:
    .dw   0xd0ce, 0x03374

ex_key_d:
    mov   r4, #20
    cmp   r1, r4
    bne   .k_21
    .dw   0xd0ce, ex_enter
.k_21:
    mov   r4, #21
    cmp   r1, r4
    bne   .k_22
    .dw   0xd0ce, ex_back_d
.k_22:
    mov   r4, #22
    cmp   r1, r4
    bne   .k_stock
    .dw   0xd0ce, pp_page_d
.k_stock:
    mov   r4, #0x13
    cmp   r4, r1
    blt   .k_out
    .dw   0xd0ce, 0x03424
.k_out:
    .dw   0xd0ce, 0x036a5

ex_key_f:
    mov   r4, #20
    cmp   r1, r4
    bne   .f_21
    .dw   0xd0ce, ex_dial
.f_21:
    mov   r4, #21
    cmp   r1, r4
    bne   .f_22
    .dw   0xd0ce, ao_dial
.f_22:
    mov   r4, #22
    cmp   r1, r4
    bne   .f_23
    .dw   0xd0ce, pp_page_f
.f_23:
    mov   r4, #23
    cmp   r1, r4
    bne   .f_24
    .dw   0xd0ce, st_dial
.f_24:
    mov   r4, #24
    cmp   r1, r4
    bne   .f_stock
    .dw   0xd0ce, bl_dial
.f_stock:
    mov   r4, #0x12
    cmp   r4, r1
    blt   .f_out
    .dw   0xd0ce, 0x03992
.f_out:
    .dw   0xd0ce, 0x03b5f

; ---- Extra (screen 20): Auto Off, Startup, Backlight, Patches, Info; cursor in bits 7-9. Icons where the menu has them.
ex_scr_extra:
    .dw   0x830d, 0x2b01
    ld    r7, [fp+0]
    push  r7
    ld    r7, [fp+3]
    .dw   0x2f07
    push  r7
    ccall 0x0584f             ; header (ex_head) and battery
    push  #0x6                ; BACK
    push  #0
    push  #0
    ccall draw_softkey
    push  #0x24               ; next
    push  #0
    push  #1
    ccall draw_softkey
    push  #0xe                ; ENTER
    push  #0
    push  #2
    ccall draw_softkey
    push  #0
    push  #0x104              ; clock
    push  #0x10
    push  #2
    ccall draw_glyph
    push  #0
    push  #0x10b              ; power
    push  #0x10
    push  #27
    ccall draw_glyph
    push  #0
    push  #0x10d              ; bulb
    push  #0x10
    push  #52
    ccall draw_glyph
    push  #0
    push  #0x105              ; puzzle piece
    push  #0x10
    push  #77
    ccall draw_glyph
    push  #0
    push  #0xcf               ; the stock Info icon
    push  #0x10
    push  #102
    ccall draw_glyph
    call  ex_norm
    shr   r7, 7
    and   r7, #7
    mov   r6, #11             ; cursor under the icon: 11 + 25 * item
    cmp   r7, #0
    beq   .x_cur
    mov   r6, #36
    cmp   r7, #1
    beq   .x_cur
    mov   r6, #61
    cmp   r7, #2
    beq   .x_cur
    mov   r6, #86
    cmp   r7, #3
    beq   .x_cur
    mov   r6, #111
.x_cur:
    push  #0
    push  #0xcd
    push  #0x28
    push  r6
    ccall draw_glyph
    .dw   0xd0ce, 0x061f5

ex_next:                      ; middle key: next item, round
    call  ex_norm
    mov   r6, r7
    shr   r6, 7
    and   r6, #7
    add   r6, #1
    cmp   r6, #5
    blt   .x_set
    mov   r6, #0
.x_set:
    li    r5, #0xfc7f
    and   r7, r5
    shl   r6, 7
    or    r7, r6
    call  ex_put
    ld    r7, [screen]
    push  r7
    ccall draw_screen
    .dw   0xd0ce, 0x03374

ex_dial:
    .dw   0xd2cd, 0x0002      ; r5 = dial delta, signed
    cmp   r5, #0
    beq   .xd_out
    shr   r5, 15              ; 1 = turned down
    call  ex_norm
    mov   r6, r7
    shr   r6, 7
    and   r6, #7
    cmp   r5, #0
    bne   .xd_down
    cmp   r6, #4
    beq   .xd_out
    add   r6, #1
    jmp   .xd_set
.xd_down:
    cmp   r6, #0
    beq   .xd_out
    li    r5, #0xffff
    add   r6, r5
.xd_set:
    li    r5, #0xfc7f
    and   r7, r5
    shl   r6, 7
    or    r7, r6
    call  ex_put
    ld    r7, [screen]
    push  r7
    ccall draw_screen
.xd_out:
    .dw   0xd0ce, 0x03b5f

ex_enter:                     ; right key: open the item
    mov   r7, #0              ; Patches start on their first page
    st    [ex_pg], r7
    call  ex_norm
    shr   r7, 7
    and   r7, #7
    mov   r6, #21
    cmp   r7, #0
    beq   .xe_go
    mov   r6, #23
    cmp   r7, #1
    beq   .xe_go
    mov   r6, #24
    cmp   r7, #2
    beq   .xe_go
    mov   r6, #22
    cmp   r7, #3
    beq   .xe_go
    mov   r7, #0
    st    [0x6a4d], r7        ; Info: first page, as the stock Enter
    mov   r6, #19
.xe_go:
    st    [screen], r6
    push  r6
    ccall draw_screen
    mov   r7, #0
    st    [0x0116], r7
    .dw   0xd0ce, 0x036a5

ex_back_menu:                 ; left key on Extra: back to the menu (as the stock Back keys)
    mov   r7, #7
    st    [screen], r7
    mov   r7, #0xff
    st    [0x6a4e], r7
    ld    r7, [screen]
    push  r7
    ccall draw_screen
    .dw   0xd0ce, 0x0314c

ex_back_a:                    ; left key on Patches, Startup and Backlight: back to Extra
    mov   r7, #20
    st    [screen], r7
    push  r7
    ccall draw_screen
    .dw   0xd0ce, 0x0314c

ex_back_d:                    ; right key on Auto Off: back to Extra
    mov   r7, #20
    st    [screen], r7
    push  r7
    ccall draw_screen
    .dw   0xd0ce, 0x036a5

; ---- Auto Off (screen 21), laid out like the Octave screen
ao_screen:
    .dw   0x830d, 0x2b01
    ld    r7, [fp+0]
    push  r7
    ld    r7, [fp+3]
    .dw   0x2f07
    push  r7
    ccall 0x0584f             ; header (ex_head) and battery
    push  #0
    push  #0x106
    push  #0xa
    push  #0
    ccall draw_glyph          ; big clock
    push  #0
    push  #0xb7
    push  #0x1e
    push  #0x37
    ccall draw_glyph
    push  #0
    push  #0xba
    push  #0x1e
    push  #0x74
    ccall draw_glyph
    call  ex_norm
    li    r6, #0x107          ; BATT
    shr   r7, 6
    and   r7, #1
    st    [text_buf], r7      ; (scratch) which one is edited
    cmp   r7, #0
    bne   .k0
    li    r6, #0x108          ; BATT, highlighted
.k0:
    push  r6
    push  #0
    push  #0
    ccall draw_softkey
    li    r6, #0x109          ; CABLE
    ld    r7, [text_buf]
    cmp   r7, #0
    beq   .k1
    li    r6, #0x10a
.k1:
    push  r6
    push  #0
    push  #1
    ccall draw_softkey
    push  #0x6                ; BACK
    push  #0
    push  #2
    ccall draw_softkey
    call  ex_norm             ; value text of the edited one
    ld    r6, [text_buf]
    cmp   r6, #0
    beq   .v_batt
    shr   r7, 3
.v_batt:
    and   r7, #7
    shl   r7, 3
    mov   r5, r7
    addi  r5, #ao_names
    ld    r6, [0x0168]        ; lang_pl: Polish names, 64 words further
    cmp   r6, #0x47
    beq   .v_en
    add   r5, #64
.v_en:
    call  ex_copy
    mov   r7, #0
    push  r7
    push  #0x10
    push  #0x39
    push  #0x19
    push  #0x3b
    ccall 0x04a69             ; clear the value area
    mov   r7, #0
    push  #text_buf
    push  r7
    push  #1
    push  r7
    push  #0x1b
    push  #0x57
    ccall draw_text_centered
    .dw   0xd0ce, 0x061f5

; copy the string at r5 (program memory, 1 char per word) to text_buf. Leaf, uses r1, r4, r5, r7.
ex_copy:
    li    r4, #text_buf
.c_loop:
    mov   r1, r5
    ldc   r7, [r1+0]
    mov   r1, r4
    st    [r1+0], r7
    add   r5, #1
    add   r4, #1
    cmp   r7, #0
    bne   .c_loop
    ret

ao_names:                     ; 8 words each, English then Polish
    .dw   0x4f, 0x46, 0x46, 0, 0, 0, 0, 0   ; OFF
    .dw   0x35, 0x20, 0x4d, 0x49, 0x4e, 0, 0, 0   ; 5 MIN
    .dw   0x31, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0, 0   ; 10 MIN
    .dw   0x31, 0x35, 0x20, 0x4d, 0x49, 0x4e, 0, 0   ; 15 MIN
    .dw   0x33, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0, 0   ; 30 MIN
    .dw   0x36, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0, 0   ; 60 MIN
    .dw   0x39, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0, 0   ; 90 MIN
    .dw   0x31, 0x32, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0   ; 120 MIN
    .dw   0x57, 0x59, 0x141, 0, 0, 0, 0, 0   ; WYŁ
    .dw   0x35, 0x20, 0x4d, 0x49, 0x4e, 0, 0, 0   ; 5 MIN
    .dw   0x31, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0, 0   ; 10 MIN
    .dw   0x31, 0x35, 0x20, 0x4d, 0x49, 0x4e, 0, 0   ; 15 MIN
    .dw   0x33, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0, 0   ; 30 MIN
    .dw   0x36, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0, 0   ; 60 MIN
    .dw   0x39, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0, 0   ; 90 MIN
    .dw   0x31, 0x32, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0   ; 120 MIN

ao_batt:                      ; left key: edit the battery time
    call  ex_norm
    li    r6, #0xffbf
    and   r7, r6
    call  ex_put
    ld    r7, [screen]
    push  r7
    ccall draw_screen
    .dw   0xd0ce, 0x0314c
ao_cable:                     ; middle key: edit the cable time
    call  ex_norm
    li    r6, #0x0040
    or    r7, r6
    call  ex_put
    ld    r7, [screen]
    push  r7
    ccall draw_screen
    .dw   0xd0ce, 0x03374

ao_dial:                      ; dial: edited time -1 / +1, clamp 0..7, save to flash
    .dw   0xd2cd, 0x0002      ; r5 = dial delta, signed
    cmp   r5, #0
    beq   .t_out
    call  ex_norm
    mov   r6, r7              ; r6 = settings
    shr   r7, 6
    and   r7, #1
    mov   r4, r7              ; r4 = 1: cable
    mov   r7, r6
    cmp   r4, #0
    beq   .t_have
    shr   r7, 3
.t_have:
    and   r7, #7
    shr   r5, 15              ; 1 = turned down
    cmp   r5, #0
    bne   .t_down
    cmp   r7, #7
    beq   .t_out
    add   r7, #1
    jmp   .t_set
.t_down:
    cmp   r7, #0
    beq   .t_out
    li    r5, #0xffff
    add   r7, r5
.t_set:
    li    r5, #0xfff8
    cmp   r4, #0
    beq   .t_mask
    shl   r7, 3
    li    r5, #0xffc7
.t_mask:
    and   r6, r5
    or    r6, r7
    mov   r7, r6
    call  ex_put
    push  #presets_header
    ccall flash_write_words   ; presets_header, its second word and current_preset, as preset loads do
    ld    r7, [screen]
    push  r7
    ccall draw_screen
.t_out:
    .dw   0xd0ce, 0x03b5f

; ---- Startup (screen 23): mode in bits 10-11, the dial changes it, the left key goes back
st_screen:
    .dw   0x830d, 0x2b01
    ld    r7, [fp+0]
    push  r7
    ld    r7, [fp+3]
    .dw   0x2f07
    push  r7
    ccall 0x0584f             ; header (ex_head) and battery
    push  #0x6                ; BACK
    push  #0
    push  #0
    ccall draw_softkey
    push  #0
    push  #0xb7
    push  #0x1e
    push  #6
    ccall draw_glyph
    push  #0
    push  #0xba
    push  #0x1e
    push  #118
    ccall draw_glyph
    call  ex_norm
    shr   r7, 10
    and   r7, #3
    mov   r5, r7              ; 10 words a name
    shl   r5, 3
    add   r5, r7
    add   r5, r7
    addi  r5, #st_names
    ld    r6, [0x0168]        ; lang_pl: Polish names, 30 words further
    cmp   r6, #0x47
    beq   .st_en
    add   r5, #30
.st_en:
    call  ex_copy
    mov   r7, #0
    push  r7
    push  #0x10
    push  #106
    push  #0x19
    push  #11
    ccall 0x04a69             ; clear the value area
    mov   r7, #0
    push  #text_buf
    push  r7
    push  #1
    push  r7
    push  #0x1b
    push  #64
    ccall draw_text_centered
    .dw   0xd0ce, 0x061f5

st_names:                     ; 10 words each, English then Polish
    .dw   0x44, 0x45, 0x46, 0x41, 0x55, 0x4c, 0x54, 0, 0, 0   ; DEFAULT
    .dw   0x41, 0x55, 0x54, 0x4f, 0x53, 0x41, 0x56, 0x45, 0, 0   ; AUTOSAVE
    .dw   0x46, 0x41, 0x43, 0x54, 0x4f, 0x52, 0x59, 0, 0, 0   ; FACTORY
    .dw   0x44, 0x45, 0x46, 0x41, 0x55, 0x4c, 0x54, 0, 0, 0   ; DEFAULT
    .dw   0x41, 0x55, 0x54, 0x4f, 0x5a, 0x41, 0x50, 0x49, 0x53, 0   ; AUTOZAPIS
    .dw   0x46, 0x41, 0x42, 0x52, 0x59, 0x43, 0x5a, 0x4e, 0x45, 0   ; FABRYCZNE

st_dial:                      ; dial: mode -1 / +1, clamp 0..2, save to flash
    .dw   0xd2cd, 0x0002      ; r5 = dial delta, signed
    cmp   r5, #0
    beq   .sd_out
    shr   r5, 15              ; 1 = turned down
    call  ex_norm
    mov   r6, r7
    shr   r6, 10
    and   r6, #3
    cmp   r5, #0
    bne   .sd_down
    cmp   r6, #2
    beq   .sd_out
    add   r6, #1
    jmp   .sd_set
.sd_down:
    cmp   r6, #0
    beq   .sd_out
    li    r5, #0xffff
    add   r6, r5
.sd_set:
    li    r5, #0xf3ff
    and   r7, r5
    shl   r6, 10
    or    r7, r6
    call  ex_put
    push  #presets_header
    ccall flash_write_words
    ld    r7, [screen]
    push  r7
    ccall draw_screen
.sd_out:
    .dw   0xd0ce, 0x03b5f

; power_off from power_key_poll: r7 = 0 from the power key, 1 from Auto Off. With Autosave the current
; settings go to the hidden page first.
st_off_key:
    mov   r7, #0
st_off:
    st    [text_buf+13], r7
    call  ex_norm
    shr   r7, 10
    and   r7, #3
    cmp   r7, #1
    bne   .o_off
    push  #user_presets+124
    ccall collect_preset
    ld    r7, [sustain_on]    ; the Sustain key is no preset field: bit 7 of field 12 (touch is 0..5)
    cmp   r7, #0
    beq   .o_write
    ld    r7, [user_presets+136]
    mov   r6, #0x80
    or    r7, r6
    st    [user_presets+136], r7
.o_write:
    push  #5                  ; page 0x701 + 5
    push  #user_presets+124
    ccall preset_write_flash
.o_off:
    ccall power_off
    ld    r7, [text_buf+13]
    cmp   r7, #0
    bne   .o_due
    .dw   0xd0ce, 0x009a4
.o_due:
    .dw   0xd0ce, 0x009af

; end of boot_presets: Factory loads the factory default, Autosave the hidden page (when it holds a preset;
; otherwise what boot_preset loaded stays). User5's RAM copy is the buffer and is read back after.
st_boot:
    mov   r7, #0              ; menu state, backlight counter (RAM is not cleared at power-on)
    st    [ex_ui], r7
    st    [ex_pg], r7
    st    [bl_count], r7
    st    [amp_cnt], r7
    call  ex_norm
    shr   r7, 10
    and   r7, #3
    cmp   r7, #2
    bne   .sb_auto
    push  #0
    ccall load_factory_preset
    .dw   0xd0ce, 0x02564     ; boot_presets' epilogue (the same word at the end of presets_load_all)
.sb_auto:
    cmp   r7, #1
    beq   .sb_read
    .dw   0xd0ce, 0x02564
.sb_read:
    li    r6, #0x0706
    .dw   0xd0ce, st_read
st_apply:                     ; the hidden page is in the buffer: erased flash reads 0xffff
    ld    r7, [user_presets+124]
    li    r6, #0xffff
    cmp   r7, r6
    beq   .sb_restore
    ld    r7, [user_presets+125]
    cmp   r7, r6
    beq   .sb_restore
    ld    r7, [user_presets+136]  ; bit 7 of field 12: the Sustain key was on (apply_preset leaves sustain_on alone)
    mov   r6, r7
    and   r6, #0x80
    st    [sustain_on], r6
    li    r6, #0xff7f
    and   r7, r6
    st    [user_presets+136], r7
    push  #user_presets+124
    ccall apply_preset
    ld    r7, [sustain_on]
    cmp   r7, #0
    beq   .sb_restore
    mov   r7, #1
    st    [sustain_on], r7
    push  #0x50               ; as the key does: CC64 = sustain_cc64[k] on every part
    ccall sustain_switch
.sb_restore:
    li    r6, #0x0705
    .dw   0xd0ce, st_read
st_done:
    .dw   0xd0ce, 0x02564

; factory reset (presets_factory_reset's frame): the stock code has already written the factory header
; (word 0 = 1, so Auto Off and Startup fall back to their defaults) and presets 0x701..0x705; also erase the
; Autosave page 0x706, so an old snapshot never comes back. User5's RAM copy is the buffer: presets_load_all
; reads it back right after.
fr_wipe:
    li    r7, #0xffff
    li    r1, #user_presets+124
    mov   r6, #0
.f_fill:
    st    [r1+0], r7
    add   r1, #1
    add   r6, #1
    cmp   r6, #31
    blt   .f_fill
    push  #5                  ; page 0x701 + 5
    push  #user_presets+124
    ccall preset_write_flash
    ccall presets_read_flash
    .dw   0xd0ce, 0x025de

; read flash page r6 (31 words) into User5's RAM copy, as presets_load_all does; then on to st_apply
; (page 0x706) or st_done (0x705). Counters in text_buf: the flash routines keep no registers.
st_read:
    st    [text_buf+12], r6
    li    r7, #user_presets+124
    st    [text_buf+14], r7
    mov   r7, #0
    st    [text_buf+15], r7
    call  0x07b2d
    mov   r7, #0
    ld    r6, [text_buf+12]
    call  0x07bf1             ; start reading page r6 at word r7
.rd_loop:
    call  flash_get_word      ; r0 = next word
    ld    r1, [text_buf+14]
    st    [r1+0], r0
    add   r1, #1
    st    [text_buf+14], r1
    ld    r7, [text_buf+15]
    add   r7, #1
    st    [text_buf+15], r7
    cmp   r7, #31
    blt   .rd_loop
    call  0x07b2d
    ld    r7, [text_buf+12]
    li    r6, #0x0706
    cmp   r7, r6
    beq   .rd_hidden
    .dw   0xd0ce, st_done
.rd_hidden:
    .dw   0xd0ce, st_apply

; ---- Patches (screen 22): names of the installed patches, 5 lines a page (like Info), page in ex_pg.
; Counters across calls live at the end of text_buf (names use at most 13 words of it).
pp_screen:
    .dw   0x830d, 0x2b01
    ld    r7, [fp+0]
    push  r7
    ld    r7, [fp+3]
    .dw   0x2f07
    push  r7
    ccall 0x0584f             ; header (ex_head) and battery
    mov   r7, #0              ; count them: one page only -> page 0
    st    [text_buf+14], r7
    st    [text_buf+15], r7
.p_count:
    ld    r7, [text_buf+14]
    cmp   r7, #10
    blt   .p_count_go
    jmp   .p_counted
.p_count_go:
    call  pp_inst
    ld    r6, [text_buf+15]
    add   r6, r7
    st    [text_buf+15], r6
    ld    r7, [text_buf+14]
    add   r7, #1
    st    [text_buf+14], r7
    jmp   .p_count
.p_counted:
    call  ex_norm
    ld    r6, [text_buf+15]
    cmp   r6, #6
    blt   .p_one_page
    jmp   .p_draw
.p_one_page:
    mov   r7, #0
    st    [ex_pg], r7
.p_draw:
    mov   r7, #0
    st    [text_buf+14], r7   ; entry
    st    [text_buf+15], r7   ; installed ones before it
.p_loop:
    ld    r7, [text_buf+14]
    cmp   r7, #10
    blt   .p_go
    .dw   0xd0ce, 0x061f5
.p_go:
    call  pp_inst             ; r7 = installed, r1 = its entry
    cmp   r7, #0
    beq   .p_next
    ldc   r5, [r1+3]          ; name
    ld    r6, [0x0168]
    cmp   r6, #0x47
    beq   .p_en
    ldc   r5, [r1+4]          ; lang_pl: Polish name
.p_en:
    ld    r7, [text_buf+15]
    mov   r6, r7
    add   r6, #1
    st    [text_buf+15], r6
    ld    r6, [ex_pg]
    and   r6, #1
    cmp   r6, #0
    beq   .p_line
    li    r6, #0xfffb         ; page 1: lines 5..9
    add   r7, r6
.p_line:
    cmp   r7, #0
    blt   .p_next
    cmp   r7, #5
    blt   .p_show
    jmp   .p_next
.p_show:
    mov   r6, r7              ; y = 14 + 10 * line, as Info
    shl   r6, 3
    add   r6, r7
    add   r6, r7
    add   r6, #14
    call  ex_copy
    push  #text_buf
    push  #1
    push  #0
    push  #0
    push  r6
    push  #6
    ccall draw_text_centered
.p_next:
    ld    r7, [text_buf+14]
    add   r7, #1
    st    [text_buf+14], r7
    jmp   .p_loop

; r7 = entry -> r7 = 1 when that patch is in the firmware, r1 = the entry. Leaf, uses r4, r5, r6.
pp_inst:
    mov   r6, r7              ; 5 words an entry
    shl   r7, 2
    add   r7, r6
    mov   r1, r7
    addi  r1, #pp_tab
    ldc   r7, [r1+0]          ; kind
    cmp   r7, #2
    beq   .q_yes
    ldc   r6, [r1+2]          ; stock word
    ldc   r5, [r1+1]          ; its address
    mov   r4, r1
    cmp   r7, #1
    beq   .q_ram
    mov   r1, r5
    ldc   r7, [r1+0]
    jmp   .q_cmp
.q_ram:
    mov   r1, r5
    ld    r7, [r1+0]
.q_cmp:
    mov   r1, r4
    cmp   r7, r6
    beq   .q_no
.q_yes:
    mov   r7, #1
    ret
.q_no:
    mov   r7, #0
    ret

pp_page_d:                    ; right key: other page
    .dw   0xd0ce, pp_flip
pp_page_f:                    ; dial: other page
    .dw   0xd2cd, 0x0002
    cmp   r5, #0
    beq   .pf_out
    .dw   0xd0ce, pp_flip
.pf_out:
    .dw   0xd0ce, 0x03b5f
pp_flip:                      ; toggle the page, redraw (one page -> pp_screen resets it)
    ld    r7, [ex_pg]
    add   r7, #1
    and   r7, #1
    st    [ex_pg], r7
    ld    r7, [screen]
    push  r7
    ccall draw_screen
    .dw   0xd0ce, 0x036a5

pp_tab:                       ; kind (0 code word, 1 RAM word, 2 always), address, stock word, name, Polish name
    .dw   0, 0x03f70, 0x0704, pp_n0, pp_p0      ; touch_off
    .dw   0, 0x02601, 0x25a3, pp_n1, pp_p1      ; boot_preset
    .dw   0, 0x022ee, 0x110c, pp_n2, pp_p2      ; sustain_in_preset
    .dw   0, 0x010d8, 0xfbd0, pp_n3, pp_p3      ; octave_per_part
    .dw   2, 0x00000, 0x0000, pp_n4, pp_p4      ; extra_menu
    .dw   1, 0x02822, 0x0056, pp_n5, pp_p5      ; version_tag
    .dw   0, 0x04b0d, 0xd14a, pp_n6, pp_p6      ; polish_font
    .dw   1, 0x00168, 0x0047, pp_n7, pp_p7      ; lang_pl
    .dw   0, 0x04fb6, 0xd14a, pp_n8, pp_p8      ; custom_voices
    .dw   1, 0x05806, 0x0000, pp_n9, pp_p9      ; welcome_cat
pp_n0:
    .dw   0x54, 0x4f, 0x55, 0x43, 0x48, 0x20, 0x4f, 0x46, 0x46, 0
pp_p0:
    .dw   0x44, 0x4f, 0x54, 0x59, 0x4b, 0x20, 0x57, 0x59, 0x141, 0
pp_n1:
    .dw   0x42, 0x4f, 0x4f, 0x54, 0x20, 0x50, 0x52, 0x45, 0x53, 0x45, 0x54, 0
pp_p1:
    .dw   0x50, 0x52, 0x45, 0x53, 0x45, 0x54, 0x20, 0x53, 0x54, 0x41, 0x52, 0x54, 0
