.patch telemetry
.title "Usage log (off unless selected): 5-minute windows of time played, volume, silence with the speaker on / off, time asleep and battery in unused flash pages, ~17 days; read only over USB on request (nuxdsp telemetry or log.html), nothing is sent by itself"

.hook 0x00c1c expect 0xd7c8 0x0948     ; battery_tick: low battery, power_off
    .dw   0xd0ce, tl_lowoff
.end

; Without extra_menu the log hooks these places itself; with it, extra_menu's own hooks there call tl_tick (with
; its sleep state and its count since the last message to the synthesizer), tl_boot, tl_close, tl_key and tl_amp
; (its .weak entry points). Without extra_menu nothing sleeps and the speaker is always on.
.hook 0x00830 expect 0xd148 0x0117 unless extra_menu   ; tick_10ms, after the outputs: ldi r1, 0x0117
    call  tl_tick0
.end
.hook 0x0d6d3 expect 0x1c01 0x070d unless extra_menu   ; the synthesizer's MIDI input: and r4, #1; mov r7, #0xd
    call  tl_note0
.end
.hook 0x03860 expect 0xd148 0x000b unless extra_menu   ; key_event: ldi r1, idle_ticks (zeroed next)
    call  tl_key0
.end
.hook 0x0391b expect 0xd148 0x000b unless extra_menu   ; the dial's handler, same
    call  tl_key0
.end
.hook 0x02602 expect 0xd5c8 0xffff unless extra_menu   ; end of boot_presets
    .dw   0xd0ce, tl_boot0
.end
.hook 0x009a2 expect 0xd7c8 0x0948 unless extra_menu   ; power key held 50 ticks -> power_off
    .dw   0xd0ce, tl_lowoff
.end
.hook 0x009ad expect 0xd7c8 0x0948 unless extra_menu   ; idle_ticks >= 180000 (Auto Off) -> power_off
    .dw   0xd0ce, tl_lowoff
.end

; ---- Telemetry: a log of 5-minute windows in DataFlash pages 0x200..0x5ff (a ring of 1024 pages, ~17 days;
; nothing in the firmware touches them, the presets are at 0x700..0x706). A page is written with
; preset_write_flash (31 words, the page erased first): word 0 = 0x8000 on the first page after power-on |
; sequence number (14 bits), then 5 entries of 6 words:
;   0 status at the window's end: batt_adc | power_src << 10 (1 = battery, checked) | charge_full << 12 | [0x0005] << 13 (H: 0 with
;     headphones) | batt_low << 14; 0xffff while the window is open
;   1 ticks with sound (fewer than 4 * PLAY_TIME ticks since something went to the synthesizer: keys, demo, metronome...)
;   2 sum of volume (0..10) over every 16th of those ticks
;   3 ticks of silence with the speaker on, 4 with the speaker off (Speaker), 5 ticks asleep (slow ticks)
; A window is 30000 awake ticks, a sleeping tick counts SLEEP_W. The page goes to flash when full, but only
; after 2 s without a panel key or the dial (tl_quiet: the stock code writes presets from those), and at
; power-off (power key, Auto Off, low battery). The USB MIDI packet AF 7D 4E (poly pressure, channel 16) sends the
; log, page by page, oldest first, then the page in RAM, over USB MIDI (sub_062cc, one packet per tick: more at
; once jams the USB output). A page goes as channel 16 messages (USB-MIDI SysEx packets not tried): pitch bend =
; page (0x7ff = RAM), then 93 x poly pressure, key k = 0..92, value = 7 bits of word k / 3, high first. Erased
; pages are skipped.
.param PLAY_TIME 75 1 250 "Telemetry: how long after the last message to the synthesizer it still counts as playing, in 40 ms (4 ticks)"
.param SLEEP_W 32 1 255 "Telemetry: 10 ms ticks per tick while asleep (checked: the power key needs 16 s instead of 0.5 s; the PLL makes 32x the crystal)"
.param DUMP_EVERY 1 1 100 "Telemetry: ticks between two pages sent over USB (after the 94 a page takes)"
.code 0x0f0b0
.equ tl_magic, 0x6330         ; 0x4c47 while the log is running (0 after init_all's copy, cleared at power-off)
.equ tl_quiet, 0x6331         ; ticks since a panel key or the dial (15 bits, wraps)
.equ tl_req, 0x6332           ; the USB input packet last looked at ([0x2900])
.equ tl_dump, 0x6333          ; 0 idle, 1 + k: flash page k of the ring next, 1025: the RAM page
.equ tl_clk, 0x6334           ; window clock
.equ tl_ampoff, 0x6335        ; amp_chk: 1 = speaker off
.equ tl_page, 0x6336          ; next page to write (0..1023)
.equ tl_seq, 0x6337
.equ tl_n, 0x6338             ; open entry (0..4)
.equ tl_full, 0x6339          ; page full, to be written
.equ tl_dcnt, 0x633a
.equ tl_i, 0x633b
.equ tl_tmp, 0x633c
.equ tl_rp, 0x633d
.equ tl_cnt, 0x633e
.equ tl_src, 0x633f
.equ tl_idx, 0x6340
.equ tl_k, 0x6342
.equ tl_v, 0x6343
.equ tl_slp, 0x6344           ; tl_tick's r7: asleep (extra_menu), 0 without it
.equ tl_play, 0x6348          ; tl_tick's r6: ticks since the last message to the synthesizer
.equ tl_pcnt, 0x6341          ; that count without extra_menu (tl_tick0, tl_note0)
.equ tl_snd, 0x6349            ; page being sent: 0 no, 1 its pitch bend next, 2 its words
.equ tl_part, 0x634a
.equ tl_skip, 0x634b
.equ tl_buf, 0x6350           ; the page being filled, 31 words
.equ tl_rd, 0x6370            ; a page read from flash, 31 words

; tick_10ms (from extra_menu's bl_tick, or tl_tick0): count, close windows, write pages, send the log
tl_tick:                      ; r7 = asleep, r6 = ticks since the last message to the synthesizer
    st    [tl_slp], r7
    st    [tl_play], r6
    call  tl_rx               ; a request from the host
    call  tl_step             ; one USB packet of the page being sent
    ld    r7, [tl_magic]
    li    r6, #0x4c47
    cmp   r7, r6
    bne   .tt_out
    ld    r7, [tl_quiet]
    add   r7, #1
    shl   r7, 1
    shr   r7, 1
    st    [tl_quiet], r7
    call  tl_slot
    mov   r6, #5              ; entry word: 5 asleep, 1 sound, 3 speaker on, 4 off
    ld    r7, [tl_slp]
    cmp   r7, #0
    bne   .tt_cat
    mov   r6, #1
    ld    r7, [tl_play]
    shr   r7, 2
    cmp   r7, #PLAY_TIME
    blt   .tt_cat
    mov   r6, #3
    ld    r7, [tl_ampoff]
    cmp   r7, #0
    beq   .tt_cat
    mov   r6, #4
.tt_cat:
    add   r1, r6
    ld    r7, [r1+0]
    add   r7, #1
    st    [r1+0], r7
    cmp   r6, #1
    bne   .tt_clk
    and   r7, #15             ; every 16th tick of sound: + volume
    cmp   r7, #0
    bne   .tt_clk
    ld    r7, [r1+1]
    ld    r6, [volume]
    add   r7, r6
    st    [r1+1], r7
    mov   r6, #1
.tt_clk:
    mov   r7, #1
    cmp   r6, #5
    bne   .tt_add
    mov   r7, #SLEEP_W
.tt_add:
    ld    r6, [tl_clk]
    add   r7, r6
    st    [tl_clk], r7
    li    r6, #30000
    cmp   r7, r6
    blt   .tt_job
    mov   r7, #0
    st    [tl_clk], r7
    call  tl_end
.tt_job:
    ld    r7, [tl_quiet]
    cmp   r7, #200
    blt   .tt_out
    ld    r7, [tl_full]
    cmp   r7, #0
    beq   .tt_send
    call  tl_flush
    jmp   .tt_out
.tt_send:
    call  tl_send
.tt_out:
    ret

; close the open entry: its status word, then the next entry, or the page is full
tl_end:
    call  tl_slot
    ld    r7, [batt_low]
    and   r7, #1
    ld    r6, [0x0005]
    and   r6, #1
    shl   r7, 1
    or    r7, r6
    ld    r6, [charge_full]
    and   r6, #1
    shl   r7, 1
    or    r7, r6
    ld    r6, [power_src]
    and   r6, #3
    shl   r7, 2
    or    r7, r6
    shl   r7, 10
    ld    r6, [batt_adc]
    or    r7, r6
    st    [r1+0], r7
    ld    r7, [tl_n]
    cmp   r7, #4
    blt   .te_next
    mov   r7, #1
    st    [tl_full], r7
    ret
.te_next:
    add   r7, #1
    st    [tl_n], r7
; a new open entry at tl_n
tl_zero:
    call  tl_slot
    li    r7, #0xffff
    st    [r1+0], r7
    mov   r7, #0
    st    [r1+1], r7
    st    [r1+2], r7
    st    [r1+3], r7
    st    [r1+4], r7
    st    [r1+5], r7
    ret

; write the page, start the next one
tl_flush:
    ld    r7, [tl_page]
    addi  r7, #(0x200 - 0x701)  ; preset_write_flash writes page 0x701 + n
    push  r7
    push  #tl_buf
    ccall preset_write_flash
    ld    r7, [tl_page]
    add   r7, #1
    shl   r7, 6
    shr   r7, 6
    st    [tl_page], r7
    ld    r7, [tl_seq]
    add   r7, #1
    shl   r7, 2
    shr   r7, 2
    st    [tl_seq], r7
; empty page with header r7
tl_new:
    li    r1, #tl_buf
    st    [r1+0], r7
    li    r7, #0xffff
    mov   r6, #1
.tn_fill:
    add   r1, #1
    st    [r1+0], r7
    add   r6, #1
    cmp   r6, #31
    blt   .tn_fill
    mov   r7, #0
    st    [tl_n], r7
    st    [tl_full], r7
    jmp   tl_zero

; tick (from tl_tick): the USB input does not go through midi_parse_byte: sub_06273 keeps the last 100 packets
; it gets (2 words each, at 0x6a58, the newest at index [0x2900]) and gives them to the synthesizer. A new
; packet AF 7D 4E (poly pressure, channel 16) starts sending the log. Only the newest packet is looked at, and
; its words in either order (which one is first is not checked on the device).
tl_rx:
    ld    r7, [0x2900]
    ld    r6, [tl_req]
    cmp   r7, r6
    beq   .rx_out
    st    [tl_req], r7
    mov   r1, r7
    shl   r1, 1
    addi  r1, #0x6a58
    ld    r7, [r1+0]
    ld    r6, [r1+1]
    li    r1, #0x0aaf
    cmp   r7, r1
    bne   .rx_b
    li    r1, #0x7d4e
    cmp   r6, r1
    beq   .rx_go
.rx_out:
    ret
.rx_b:
    li    r1, #0x7d4e
    cmp   r7, r1
    bne   .rx_out
    li    r1, #0x0aaf
    cmp   r6, r1
    bne   .rx_out
.rx_go:
    mov   r7, #1
    st    [tl_dump], r7
    ret

tl_pp:                        ; tl_step: AF, tl_k++, r7 & 0x7f
    and   r7, #0x7f
    st    [tl_v], r7
    ld    r7, [tl_k]
    shl   r7, 8
    ld    r6, [tl_v]
    add   r7, r6
    st    [tl_v], r7
    ld    r7, [tl_k]
    add   r7, #1
    st    [tl_k], r7
    ld    r7, [tl_v]
    li    r6, #0x0aaf         ; cable 0, CIN A, AF
; USB-MIDI packet r6 (cable << 12 | CIN << 8 | status) : r7 (data 1 << 8 | data 2) to the host, as route_note_on
; does it (sub_062cc, the USB stack: the low word is pushed first)
tl_pk:
    push  r7
    push  r6
    ccall 0x062cc
    ret

.end
.code 0x08e5a
; read tl_cnt words of flash page tl_page + r7 (mod 1024) into tl_rd, as st_read (the flash routines keep no
; registers); tl_idx = the ring index; r7 = the first word
tl_rdp:
    ld    r6, [tl_page]
    add   r7, r6
    shl   r7, 6
    shr   r7, 6
    st    [tl_idx], r7
    addi  r7, #0x200
    st    [tl_rp], r7
    call  0x07b2d
    mov   r7, #0
    ld    r6, [tl_rp]
    call  0x07bf1
    mov   r7, #0
    st    [tl_i], r7
.tr_loop:
    call  flash_get_word
    ld    r7, [tl_i]
    mov   r1, r7
    addi  r1, #tl_rd
    st    [r1+0], r0
    add   r7, #1
    st    [tl_i], r7
    ld    r6, [tl_cnt]
    cmp   r7, r6
    blt   .tr_loop
    call  0x07b2d
    ld    r7, [tl_rd]
    ret

; power-on (st_boot): find where the ring goes on (the first page that does not follow its predecessor)
tl_boot:
    li    r1, #tl_magic
    mov   r7, #0
    st    [r1+0], r7          ; tl_magic
    st    [r1+1], r7          ; tl_quiet
    st    [r1+2], r7          ; tl_req
    st    [r1+3], r7          ; tl_dump
    st    [r1+4], r7          ; tl_clk
    st    [r1+5], r7          ; tl_ampoff
    st    [r1+6], r7          ; tl_page
    mov   r7, #1
    st    [tl_cnt], r7
    mov   r7, #0
    call  tl_rdp              ; page 0: erased (bit 14) -> start there with 0
    shl   r7, 1
    shr   r7, 1
    st    [tl_tmp], r7
    shr   r7, 14
    cmp   r7, #0
    beq   .tb_next
    li    r7, #0xffff
    st    [tl_tmp], r7
    jmp   .tb_found
.tb_next:
    ld    r7, [tl_page]
    add   r7, #1
    st    [tl_page], r7
    li    r6, #1024
    cmp   r7, r6
    blt   .tb_rd
    mov   r7, #0
    st    [tl_page], r7
    jmp   .tb_found
.tb_rd:
    mov   r7, #0
    call  tl_rdp
    shl   r7, 1
    shr   r7, 1
    ld    r6, [tl_tmp]
    add   r6, #1
    shl   r6, 2
    shr   r6, 2
    cmp   r7, r6
    bne   .tb_found
    st    [tl_tmp], r7
    jmp   .tb_next
.tb_found:
    ld    r7, [tl_tmp]
    add   r7, #1
    shl   r7, 2
    shr   r7, 2
    st    [tl_seq], r7
    li    r6, #0x8000
    or    r7, r6
    call  tl_new
    li    r7, #0x4c47
    st    [tl_magic], r7
    ret

; power-off: close the entry, write the page, stop
tl_close:
    ld    r7, [tl_magic]
    li    r6, #0x4c47
    cmp   r7, r6
    bne   .tc_out
    call  tl_end
    call  tl_flush
    mov   r7, #0
    st    [tl_magic], r7
.tc_out:
    ret

tl_lowoff:                    ; battery_tick, low battery (0x0c1c)
    call  tl_close
    ccall power_off

.end
.code 0x09169
; one page of the log every DUMP_EVERY ticks (from tl_tick, quiet)
tl_send:
    ld    r7, [tl_snd]
    cmp   r7, #0
    bne   .tls_out
    ld    r7, [tl_dump]
    cmp   r7, #0
    beq   .tls_out
    ld    r6, [tl_dcnt]
    add   r6, #1
    st    [tl_dcnt], r6
    cmp   r6, #DUMP_EVERY
    blt   .tls_out
    mov   r6, #0
    st    [tl_dcnt], r6
    mov   r7, #31
    st    [tl_cnt], r7
    mov   r7, #16             ; erased pages skipped per tick: each is a flash read
    st    [tl_skip], r7
.tls_next:
    ld    r7, [tl_dump]
    li    r6, #1025
    cmp   r7, r6
    blt   .tls_flash
    mov   r7, #0
    st    [tl_dump], r7
    li    r7, #0x7ff
    st    [tl_idx], r7
    li    r7, #tl_buf
    jmp   .tls_send
.tls_flash:
    add   r7, #1
    st    [tl_dump], r7
    addi  r7, #0xfffe         ; page tl_page + k
    call  tl_rdp
    li    r6, #0xffff
    cmp   r7, r6
    beq   .tls_skip           ; erased
    li    r7, #tl_rd
    jmp   .tls_send
.tls_skip:                    ; the next one now, or in the next tick
    ld    r7, [tl_skip]
    li    r6, #0xffff
    add   r7, r6
    st    [tl_skip], r7
    cmp   r7, #0
    bne   .tls_next
    ret
.tls_send:                    ; start sending the 31 words at r7 (page tl_idx), one packet per tick (tl_step)
    st    [tl_src], r7
    mov   r7, #1
    st    [tl_snd], r7
.tls_out:
    ret

; tick: the next packet of the page: channel 16, pitch bend = the ring index, then 93 x poly pressure, key
; k = 0..92, value = 7 bits of word k/3 (high first). One per tick: more at once jams the USB output.
tl_step:
    ld    r7, [tl_snd]
    cmp   r7, #0
    beq   .tls_out
    cmp   r7, #1
    bne   .tp_word
    mov   r7, #2
    st    [tl_snd], r7
    mov   r7, #0
    st    [tl_i], r7
    st    [tl_k], r7
    st    [tl_part], r7
    ld    r7, [tl_idx]
    shr   r7, 7
    st    [tl_v], r7
    ld    r7, [tl_idx]
    and   r7, #0x7f
    shl   r7, 8
    ld    r6, [tl_v]
    add   r7, r6
    li    r6, #0x0eef         ; USB-MIDI: cable 0, CIN E, EF
    call  tl_pk
    ret
.tp_word:
    ld    r7, [tl_i]
    ld    r1, [tl_src]
    add   r1, r7
    ld    r7, [r1+0]
    ld    r6, [tl_part]
    cmp   r6, #0
    bne   .tp_p1
    shr   r7, 14
.tp_p1:
    cmp   r6, #1
    bne   .tp_go
    shr   r7, 7
.tp_go:
    add   r6, #1
    cmp   r6, #3
    blt   .tp_st
    mov   r6, #0
    ld    r1, [tl_i]
    add   r1, #1
    st    [tl_i], r1
    cmp   r1, #31
    blt   .tp_st
    st    [tl_snd], r6
.tp_st:
    st    [tl_part], r6
    call  tl_pp
    ret

.end
.code 0x09ad4
; bl_wake (extra_menu): a panel key or the dial; r1 = 0
tl_key:
    st    [tl_quiet], r1
    ret

; amp_chk (extra_menu), every tick: r7 = 1 while the speaker is off
tl_amp:
    st    [tl_ampoff], r7
    ret

; r1 = the open entry (tl_n kept in 0..4). Leaf, uses r7 (telemetry).
tl_slot:
    ld    r7, [tl_n]
    cmp   r7, #5
    blt   .ts_ok
    mov   r7, #4
    st    [tl_n], r7
.ts_ok:
    shl   r7, 1
    mov   r1, r7
    shl   r7, 1
    add   r1, r7
    addi  r1, #(tl_buf + 1)
    ret
.end
.code 0x09ad4
; tick_10ms without extra_menu (0x0830): count the ticks since the last message to the synthesizer, as
; extra_menu's amp_chk does; not asleep. Ends with r1 = 0x0117, as the instruction it replaces.
tl_tick0:
    ld    r6, [tl_pcnt]
    li    r7, #30000
    cmp   r6, r7
    blt   .t0_inc
    jmp   .t0_go
.t0_inc:
    add   r6, #1
    st    [tl_pcnt], r6
.t0_go:
    mov   r7, #0
    call  tl_tick
    li    r1, #0x0117
    ret
.end
.code 0x062f3
tl_note0:                     ; the synthesizer's input without extra_menu: a message, count from 0
    mov   r7, #0
    st    [tl_pcnt], r7
    and   r4, #1
    mov   r7, #0xd
    ret
tl_key0:                      ; key_event / the dial without extra_menu
    mov   r1, #0
    st    [tl_quiet], r1
    li    r1, #0x000b
    ret
.end
.code 0x09169
tl_boot0:                     ; end of boot_presets without extra_menu (as extra_menu's st_boot ends)
    call  tl_boot
    .dw   0xd0ce, 0x02564     ; boot_presets' epilogue
.end
