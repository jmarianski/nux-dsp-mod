.patch sustain_midi_out
.title "Sustain pedal on MIDI out: the pedal's CC64 also goes to the wireless dongle, as the Sustain key's does"

; The pedal is not a keyboard CC64. The MCU reports it on channel 16 as controller 0x74 (any value but 0:
; down), and mcu_cc 0x2185 (0x21a6: cmp #0x74, long beq to 0x2242) calls pedal_in(0, 0 or 127, 0). pedal_in
; 0x1204 keeps the state of the three pedals and, on a change, calls cc_all_parts(pedal_cc[0] = 64, value,
; 0) 0x0e60, which calls cc_out(part, 0, 64, value) 0x0de0 for every part in use. cc_out sends the CC to
; synth_send and, as a USB-MIDI packet, to usb_out_packet, and that is all: the pedal reaches USB (checked:
; ch 0..2 per press, from the stock firmware already), never port2_out_packet, the NUX dongle's way out
; (0x2cbe -> the byte queue at 0x312c that the dongle's NUX handshake also goes through).
;
; The Sustain key (sustain_switch 0x3377) sends, for each part k = 0..2, synth_send, usb_out_packet and then
; port2_out_packet with the same packet: 0x33b3 loads it from its frame (fbe2 fffd fbf7), pushes the low word
; then the high word, ccall 0x2cbe. Notes (route_note_on) end with port2_out_packet too. That is why the key
; reaches the dongle and the pedal did not.
;
; Here cc_out, after its stock ccall usb_out_packet, does what the Sustain key does: for controller 64 (and
; only 64) it loads the same packet from its own frame (stored at 0x0e57: high word at [bp-6], low at [bp-5])
; and ccalls port2_out_packet with it. Same function, same packet form, same order, same task as the key
; (task_key_events, through mcu_cc). Per part, as on USB: CC64 on channel 0, 1, 2 (B0|part, 64, 0 or 127).
; cc_out sends only on a change (its per-part cache), so the dongle gets what USB gets.
;
; Pedal and Sustain key are not merged, as inside: each one's messages go out as they are, the last one
; wins. With the key on, pressing the pedal sends CC64 127 on each part and releasing it CC64 0, which
; releases the sustain inside and outside alike while the key stays drawn on.
;
; [bp+k] (d2cN/fbe2 with a 16-bit offset) is the frame of the C call (arguments from bp+2); it survives the
; ccall usb_out_packet, as sustain_switch relies on at 0x33b3. The ccalls are made from bank 0.

.hook 0x00e57 expect 0xd3cc 0xfffb 0xd3cd 0xfffa 0x7e04 0x7e05 0xd7c8 0x62cc
    .dw   0xd3cc, 0xfffb                 ; (as stock) the packet: low word at [bp-5]
    .dw   0xd3cd, 0xfffa                 ; high word (CIN << 8 | status) at [bp-6]
    push  r4                             ; usb_out_packet's words, as stock
    push  r5
    .dw   0xd0ce, so_usb                 ; ljmp so_usb (instead of the ccall)
.end

.code 0x09169
; cc_out(part, ch, controller, value), its packet pushed. Reached by a jump from the hook.
so_usb:
    ccall usb_out_packet                 ; (replaced) as stock
    .dw   0xd2cf, 0x0004                 ; ld r7, [bp+4]: the controller
    .dw   0xd0ce, so_cc64                ; ljmp so_cc64
.end

.code 0x0f0b0
; r7 = the controller. CC64: the packet once more, to port2_out_packet, as sustain_switch does. Then
; cc_out's own epilogue (0x0e5f).
so_cc64:
    cmp   r7, #0x40
    bne   .ret
    .dw   0xfbe2, 0xfffa, 0xfbf7         ; r7 = [bp-6] (high word), r6 = [bp-5] (low word)
    push  r6
    push  r7
    ccall port2_out_packet
.ret:
    .dw   0xd5cc                         ; (as stock, 0x0e5f) return from cc_out, 4 arguments
.end
