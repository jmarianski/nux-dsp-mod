.patch sustain_midi_out
.title "Sustain pedal on MIDI out: the pedal's CC64 also goes to USB and the wireless dongle, as the Sustain key's does"

; Stock: the Sustain key (sustain_switch) sends, for each part k = 0..3, CC64 to the internal synth
; (synth_send) and the same message as a USB-MIDI packet to usb_out_packet and port2_out_packet, so
; it reaches a computer and the NUX wireless dongle (checked: an FM-1 receives it through the dongle).
; Pitch bend from the keyboard goes out the same way. A control change from the keyboard (the pedal
; is CC64 on the keyboard's channel) only goes to synth_send in task_key_events, so the pedal never
; leaves the instrument.
;
; Here, after that synth_send, CC64 (and only CC64) is sent out once more through the same two
; functions, in the same packet form the firmware uses: high word CIN << 8 | status (0x0bb0 | channel,
; as synth_send gets it), low word controller << 8 | value. What goes out is exactly what the internal
; synth got: same channel, same value.
;
; Pedal and Sustain key are not merged: each one's messages go out as they are, as inside. With the
; key on, pressing the pedal sends CC64 127 (or what the keyboard sends) on its channel, and releasing it
; CC64 0, which releases that channel's sustain inside and outside alike, while the key stays drawn on;
; switching the key off or on sends its four messages again. The last message wins, everywhere.
;
; The C-style calls are made from bank 0, as the Sustain key's are. A first version made them from bank 1
; (a far pool): USB got the pedal, the dongle did not (checked on the device). port2_out_packet goes through
; 0x1561, which picks its case from a table read with ldc and jumps through it (c749); from code reached by a
; far call that evidently goes wrong (H: ldc or the jump follows the caller's bank), while usb_out_packet
; has no such table. Only so_args, a leaf without ccall, stays in bank 1.
;
; The hook (0x28ef..0x28f8) gets the two words from so_args and, for any controller but 64, pushes them for
; the stock ccall synth_send at 0x28f9 and its exit. CC64 jumps to so_cc64 (bank 0, 12 words: the last hole
; of the bank-0 pools when every bundled patch is applied), which pushes the words three times, makes the two
; output ccalls and jumps back to 0x28f9 for synth_send, whose words were pushed first. No fp or register
; has to survive a ccall: each callee pops its own two words, and the case ends with the jump to the exit.

.hook 0x028ef expect 0xc795 0x1f7f 0xc694 0xf698 0xa607 0x7e06 0xc792 0xd74c 0x0bb0 0x7e07
    call  so_args                        ; r1 = the event, loaded just before (0x28ed)
    cmp   r1, #0x40
    bne   .push
    .dw   0xd0ce, so_cc64                ; ljmp so_cc64
    .dw   0x7800, 0x7800                 ; (not reached)
.push:
    push  r6                             ; (replaced) as stock, for the ccall synth_send that follows
    push  r7
.end

.code 0x0f0b0
; CC64: r7 = CIN << 8 | status, r6 = 64 << 8 | value (so_args). Reached by a jump from the hook.
so_cc64:
    push  r6                             ; synth_send's words (at 0x28f9, last)
    push  r7
    push  r6                             ; port2_out_packet's
    push  r7
    push  r6                             ; usb_out_packet's (low word first, as sustain_switch)
    push  r7
    ccall usb_out_packet
    ccall port2_out_packet
    .dw   0xd0ce, 0x28f9                 ; ljmp to the stock ccall synth_send, then the exit
.end

.code 0x19720
; r1 = the keyboard event (+2 channel, +4 controller, +5 value) -> r7 = CIN << 8 | status (0x0bb0 | channel,
; as synth_send gets it), r6 = controller << 8 | value (the replaced instructions), r1 = the controller.
; Leaf.
so_args:
    ld    r7, [r1+5]
    and   r7, #0x7f
    ld    r6, [r1+4]
    shl   r6, 8
    or    r6, r7
    ld    r7, [r1+2]
    li    r1, #0x0bb0
    or    r7, r1
    mov   r1, r6
    shr   r1, 8
    ret
.end
