.patch auto_off

.title "Auto Off: new last item in the function menu, with separate times on battery and on cable (Off, 5..120 min)"
; Stock: power_key_poll switches off after 180000 ticks (30 min) of idle_ticks, and battery_tick zeroes
; idle_ticks every tick while the charger is plugged, so on cable the instrument never switches off.
; Here the zeroing is gone and the limit comes from the settings word:
;   presets_header[0]  0xA5 in the high byte when set by us (stock flash holds 1 -> defaults)
;                      bits 0-2 battery time, bits 3-5 cable time (0 = Off, 5, 10, 15, 30, 60, 90, 120 min),
;                      bit 6 which one the Auto Off screen edits
; The firmware reads that word from flash at power-on and writes it back with every preset load, but
; never uses it. Defaults: battery 30 min (as stock), cable Off (as stock). power_src 0 counts as cable.
;
; Menu: a 13th item (index 12, screen 20) alone on a 4th page. Up/down/dial handlers of the menu are
; replaced by ones that keep row = index & 3 and page = index >> 2 up to 12. Screen 20 is reached
; through hooks in front of the range checks of draw_screen and the key dispatchers (A, B, D, dial).
; Its images (ids 0x100 and up) are drawn by our own blitter from program memory, hooked into draw_glyph.

.param BATT_DEFAULT 4 0 7 "Battery time when not set yet: 0 Off, 1 5 min, 2 10, 3 15, 4 30, 5 60, 6 90, 7 120 min"
.param CABLE_DEFAULT 0 0 7 "Cable time when not set yet (same values)"

.hook 0x009a4 expect 0xfbf1 0xbf20 0x0002 0xd148 0x000b 0xfa81 0xfaf7 0xfa13 0xe102 0xd7c8 0x0948  ; idle_ticks >= 180000 -> power_off
    .dw   0xd0ce, ao_due
    .dw   0x7800, 0x7800, 0x7800, 0x7800, 0x7800, 0x7800, 0x7800, 0x7800, 0x7800
.end

.hook 0x00b15 expect 0xfb63 0xd148 0x000b 0xce91 0xcf90   ; battery_tick on cable: idle_ticks = 0
    .dw   0x7800, 0x7800, 0x7800, 0x7800, 0x7800
.end

; function menu (screen 7)
.hook 0x0e058 expect 0x30a2     ; up
    .dw   ao_menu_up
.end
.hook 0x0e06b expect 0x3205     ; down
    .dw   ao_menu_down
.end
.hook 0x0e0ad expect 0x3a10     ; dial
    .dw   ao_menu_dial
.end
.hook 0x05afa expect 0x0f02 0xe302 0x0704   ; list: the last page has 1 item (stock: page 2 has 4)
    cmp   r7, #3
    .dw   0xe302
    mov   r7, #1
.end
.hook 0x05b0f expect 0xd14a 0xe357 0xd790 0x1701   ; list: small icon of item r1
    call  ao_icon
    .dw   0x7800, 0x7800
.end
.hook 0x05b2a expect 0xd148 0x0114 0xc190 0x1101 0xd14a 0xe363 0xd790   ; menu header
    call  ao_head
    .dw   0x7800, 0x7800, 0x7800, 0x7800, 0x7800
.end
.hook 0x05b67 expect 0xd148 0x0114 0xc190 0x1101 0xd14a 0xe363 0xd790   ; same, when only the row changed
    call  ao_head
    .dw   0x7800, 0x7800, 0x7800, 0x7800, 0x7800
.end
.hook 0x0585f expect 0xd148 0x0114 0xc190 0x1101 0xd14a 0xe363 0xd790   ; same, on the item screens
    call  ao_head
    .dw   0x7800, 0x7800, 0x7800, 0x7800, 0x7800
.end
.hook 0x05b7f expect 0x0705 0xd4ce 0x1722   ; scroll bar: x of the thumb for 13 items
    call  ao_bar
    .dw   0x7800
.end

; screen 20
.hook 0x05c7a expect 0x0413 0xd2c9 0x0002 0x8c01 0xe002 0xd0ce 0x61f5   ; draw_screen: screen range check
    .dw   0xd0ce, ao_draw
    .dw   0x7800, 0x7800, 0x7800, 0x7800, 0x7800
.end
.hook 0x03023 expect 0x0413 0x8c01 0xfce7 0x0125   ; key A (left): range check of the screen table
    .dw   0xd0ce, ao_key_a
    .dw   0x7800, 0x7800
.end
.hook 0x0315e expect 0x0411 0x8c01 0xfce7 0x0212   ; key B (middle)
    .dw   0xd0ce, ao_key_b
    .dw   0x7800, 0x7800
.end
.hook 0x03420 expect 0x0413 0x8c01 0xfce7 0x0281   ; key D (right)
    .dw   0xd0ce, ao_key_d
    .dw   0x7800, 0x7800
.end
.hook 0x0398e expect 0x0412 0x8c01 0xfce7 0x01cd   ; dial
    .dw   0xd0ce, ao_key_f
    .dw   0x7800, 0x7800
.end
.hook 0x0496d expect 0x0707 0x830d 0x2b07 0xcfb6   ; draw_glyph: ids >= 0x100 are ours
    .dw   0xd0ce, ao_glyph
    .dw   0x7800, 0x7800
.end

.code
; r7 = settings word (with the 0xA5 marker; defaults when the flash holds something else). Leaf, uses r6.
ao_get:
    ld    r7, [presets_header]
    mov   r6, r7
    shr   r6, 8
    cmp   r6, #0xa5
    beq   .g_ok
    li    r7, #0xa500
    add   r7, #BATT_DEFAULT
    add   r7, #(CABLE_DEFAULT * 8)
.g_ok:
    ret

; r7 = settings -> r7 = the time index (0..7) of the power source we run on now
ao_cur:
    ld    r6, [power_src]
    cmp   r6, #1
    beq   .c_batt
    shr   r7, 3
.c_batt:
    and   r7, #7
    ret

; from power_key_poll (its frame): idle_ticks >= limit -> power_off
ao_due:
    call  ao_get
    call  ao_cur
    cmp   r7, #0
    beq   .d_no
    shl   r7, 1
    mov   r1, r7
    addi  r1, #ao_limits
    ldc   r7, [r1+0]          ; limit, high word
    ld    r6, [idle_ticks]    ; high word first (H: [0xb] = high, [0xc] = low)
    cmp   r6, r7
    blt   .d_no
    bne   .d_off
    ldc   r7, [r1+1]          ; same high word: compare the low words, halved so they stay positive
    shr   r7, 1
    ld    r6, [idle_ticks+1]
    shr   r6, 1
    cmp   r6, r7
    blt   .d_no
.d_off:
    ccall power_off
.d_no:
    .dw   0xd0ce, 0x009af

ao_limits:                    ; ticks (10 ms): minutes * 6000, high word then low word
    .dw   0x0000, 0x0000      ; Off
    .dw   0x0000, 0x7530      ; 5 min
    .dw   0x0000, 0xea60      ; 10
    .dw   0x0001, 0x5f90      ; 15
    .dw   0x0002, 0xbf20      ; 30 (stock)
    .dw   0x0005, 0x7e40      ; 60
    .dw   0x0008, 0x3d60      ; 90
    .dw   0x000a, 0xfc80      ; 120

; ---- function menu
; r7 = new index (0..12): store it with its row and page, redraw the list
ao_menu_set:
    st    [0x0114], r7
    mov   r6, r7
    and   r6, #3
    st    [0x3a0a], r6
    shr   r7, 2
    st    [0x0115], r7
    ret

ao_menu_up:
    ld    r7, [0x0114]
    cmp   r7, #0
    beq   .u_out
    li    r6, #0xffff
    add   r7, r6
    call  ao_menu_set
    ccall 0x05adc
.u_out:
    .dw   0xd0ce, 0x0314c

ao_menu_down:
    ld    r7, [0x0114]
    cmp   r7, #12
    beq   .n_out
    add   r7, #1
    call  ao_menu_set
    ccall 0x05adc
.n_out:
    .dw   0xd0ce, 0x03374

ao_menu_dial:
    .dw   0xd2cd, 0x0002      ; r5 = dial delta, signed
    cmp   r5, #0
    beq   .m_out
    ld    r7, [0x0114]
    shr   r5, 15              ; 1 = turned down
    cmp   r5, #0
    bne   .m_down
    cmp   r7, #12
    beq   .m_out
    add   r7, #1
    jmp   .m_set
.m_down:
    cmp   r7, #0
    beq   .m_out
    li    r6, #0xffff
    add   r7, r6
.m_set:
    call  ao_menu_set
    ccall 0x05adc
.m_out:
    .dw   0xd0ce, 0x03b5f

; r1 = item -> r7 = its small icon
ao_icon:
    mov   r7, r1
    cmp   r7, #12
    bne   .i_stock
    li    r7, #0x100
    ret
.i_stock:
    addi  r1, #0xe357
    ldc   r7, [r1+0]
    add   r7, #1
    ret

; r7 = header image of the current item (keeps r5)
ao_head:
    ld    r7, [0x0114]
    cmp   r7, #12
    bne   .h_stock
    li    r7, #0x101
    ret
.h_stock:
    mov   r1, r7
    add   r1, #1
    addi  r1, #0xe363
    ldc   r7, [r1+0]
    ret

; r6 = item -> r7 = x of the scroll bar thumb: 0x22 + 4.5 * item (stock 5 * item, for 12 items)
ao_bar:
    mov   r7, r6
    shl   r7, 3
    add   r7, r6
    shr   r7, 1
    add   r7, #0x22
    ret

; ---- screen 20
; draw_screen, r1 = screen
ao_draw:
    .dw   0xd2c9, 0x0002
    mov   r4, #20
    cmp   r1, r4
    beq   ao_screen
    mov   r4, #0x13
    cmp   r4, r1
    blt   .s_none
    .dw   0xd0ce, 0x05c81
.s_none:
    .dw   0xd0ce, 0x061f5

ao_screen:                    ; laid out like the Octave screen
    .dw   0x830d, 0x2b01
    ld    r7, [fp+0]
    push  r7
    ld    r7, [fp+3]
    .dw   0x2f07
    push  r7
    ccall 0x0584f             ; header (ao_head) and battery
    push  #0
    push  #0x102
    push  #0xa
    push  #0
    ccall draw_glyph          ; big clock
    push  #0
    push  #0xb7
    push  #0x1e
    push  #0x37
    ccall draw_glyph
    push  #0
    push  #0xba
    push  #0x1e
    push  #0x74
    ccall draw_glyph
    call  ao_get
    li    r6, #0x103          ; BATT
    shr   r7, 6
    and   r7, #1
    st    [text_buf], r7      ; (scratch) which one is edited
    cmp   r7, #0
    bne   .k0
    li    r6, #0x104          ; BATT, highlighted
.k0:
    push  r6
    push  #0
    push  #0
    ccall draw_softkey
    li    r6, #0x105          ; CABLE
    ld    r7, [text_buf]
    cmp   r7, #0
    beq   .k1
    li    r6, #0x106
.k1:
    push  r6
    push  #0
    push  #1
    ccall draw_softkey
    push  #0x6                ; BACK
    push  #0
    push  #2
    ccall draw_softkey
    call  ao_get              ; value text of the edited one
    ld    r6, [text_buf]
    cmp   r6, #0
    beq   .v_batt
    shr   r7, 3
.v_batt:
    and   r7, #7
    shl   r7, 3
    mov   r5, r7
    addi  r5, #ao_names
    li    r4, #text_buf
.v_copy:
    mov   r1, r5
    ldc   r7, [r1+0]
    mov   r1, r4
    st    [r1+0], r7
    add   r5, #1
    add   r4, #1
    cmp   r7, #0
    bne   .v_copy
    mov   r7, #0
    push  r7
    push  #0x10
    push  #0x39
    push  #0x19
    push  #0x3b
    ccall 0x04a69             ; clear the value area
    mov   r7, #0
    push  #text_buf
    push  r7
    push  #1
    push  r7
    push  #0x1b
    push  #0x57
    ccall draw_text_centered
    .dw   0xd0ce, 0x061f5

ao_names:                     ; 8 words each
    .dw   0x4f, 0x46, 0x46, 0, 0, 0, 0, 0                    ; OFF
    .dw   0x35, 0x20, 0x4d, 0x49, 0x4e, 0, 0, 0              ; 5 MIN
    .dw   0x31, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0, 0           ; 10 MIN
    .dw   0x31, 0x35, 0x20, 0x4d, 0x49, 0x4e, 0, 0
    .dw   0x33, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0, 0
    .dw   0x36, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0, 0
    .dw   0x39, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0, 0
    .dw   0x31, 0x32, 0x30, 0x20, 0x4d, 0x49, 0x4e, 0        ; 120 MIN

; keys: r1 = screen. Screen 20 goes to us, the rest to the stock range check and table.
ao_key_a:
    mov   r4, #20
    cmp   r1, r4
    beq   ao_batt
    mov   r4, #0x13
    cmp   r4, r1
    blt   .a_out
    .dw   0xd0ce, 0x03027
.a_out:
    .dw   0xd0ce, 0x0314c
ao_key_b:
    mov   r4, #20
    cmp   r1, r4
    beq   ao_cable
    mov   r4, #0x11
    cmp   r4, r1
    blt   .b_out
    .dw   0xd0ce, 0x03162
.b_out:
    .dw   0xd0ce, 0x03374
ao_key_d:
    mov   r4, #20
    cmp   r1, r4
    beq   ao_back
    mov   r4, #0x13
    cmp   r4, r1
    blt   .e_out
    .dw   0xd0ce, 0x03424
.e_out:
    .dw   0xd0ce, 0x036a5
ao_key_f:
    mov   r4, #20
    cmp   r1, r4
    beq   ao_dial
    mov   r4, #0x12
    cmp   r4, r1
    blt   .f_out
    .dw   0xd0ce, 0x03992
.f_out:
    .dw   0xd0ce, 0x03b5f

ao_batt:                      ; left key: edit the battery time
    call  ao_get
    li    r6, #0xffbf
    and   r7, r6
    st    [presets_header], r7
    ld    r7, [screen]
    push  r7
    ccall draw_screen
    .dw   0xd0ce, 0x0314c
ao_cable:                     ; middle key: edit the cable time
    call  ao_get
    li    r6, #0x0040
    or    r7, r6
    st    [presets_header], r7
    ld    r7, [screen]
    push  r7
    ccall draw_screen
    .dw   0xd0ce, 0x03374
ao_back:                      ; right key: back to the menu (as the stock Back keys)
    mov   r7, #7
    st    [screen], r7
    mov   r7, #0xff
    st    [0x6a4e], r7
    ld    r7, [screen]
    push  r7
    ccall draw_screen
    .dw   0xd0ce, 0x036a5

ao_dial:                      ; dial: edited time -1 / +1, clamp 0..7, save to flash
    .dw   0xd2cd, 0x0002      ; r5 = dial delta, signed
    cmp   r5, #0
    beq   .t_out
    call  ao_get
    mov   r6, r7              ; r6 = settings
    shr   r7, 6
    and   r7, #1
    mov   r4, r7              ; r4 = 1: cable
    mov   r7, r6
    cmp   r4, #0
    beq   .t_have
    shr   r7, 3
.t_have:
    and   r7, #7
    shr   r5, 15              ; 1 = turned down
    cmp   r5, #0
    bne   .t_down
    cmp   r7, #7
    beq   .t_out
    add   r7, #1
    jmp   .t_set
.t_down:
    cmp   r7, #0
    beq   .t_out
    li    r5, #0xffff
    add   r7, r5
.t_set:
    li    r5, #0xfff8
    cmp   r4, #0
    beq   .t_mask
    shl   r7, 3
    li    r5, #0xffc7
.t_mask:
    and   r6, r5
    or    r6, r7
    st    [presets_header], r6
    push  #presets_header
    ccall flash_write_words   ; presets_header, its second word and current_preset, as preset loads do
    ld    r7, [screen]
    push  r7
    ccall draw_screen
.t_out:
    .dw   0xd0ce, 0x03b5f

; ---- images 0x100.. : draw_glyph(x, y, id, inverse) for our ids, from program memory.
; Format: W, H, then per column ceil(H / 16) words, MSB = top row. Frame locals of draw_glyph:
; [fp+0] column, [fp+1] data pointer, [fp+2] W, [fp+3] bits, [fp+4] H, [fp+5] row.
ao_glyph:
    .dw   0x830d, 0x2b07
    ld    r7, [fp+11]
    li    r6, #0x100
    cmp   r7, r6
    blt   .q_stock
    li    r6, #0xff00
    add   r7, r6
    mov   r1, r7
    addi  r1, #ao_images
    ldc   r7, [r1+0]
    mov   r1, r7
    ldc   r6, [r1+0]
    st    [fp+2], r6
    ldc   r6, [r1+1]
    st    [fp+4], r6
    add   r7, #2
    st    [fp+1], r7
    mov   r7, #0
    st    [fp+0], r7
.q_col:
    ld    r7, [fp+0]
    ld    r6, [fp+2]
    cmp   r7, r6
    blt   .q_col_go
    .dw   0xd0ce, 0x04a3b     ; draw_glyph's epilogue
.q_col_go:
    mov   r7, #0
    st    [fp+5], r7
.q_row:
    ld    r7, [fp+5]
    ld    r6, [fp+4]
    cmp   r7, r6
    blt   .q_row_go
    ld    r7, [fp+0]          ; next column; its words start on a new word
    add   r7, #1
    st    [fp+0], r7
    jmp   .q_col
.q_row_go:
    and   r7, #15
    cmp   r7, #0
    bne   .q_bit
    ld    r1, [fp+1]
    ldc   r7, [r1+0]
    st    [fp+3], r7
    ld    r7, [fp+1]
    add   r7, #1
    st    [fp+1], r7
.q_bit:
    ld    r7, [fp+3]
    mov   r6, r7
    shl   r6, 1
    st    [fp+3], r6
    shr   r7, 15
    ld    r6, [fp+12]
    cmp   r6, #0
    beq   .q_put
    li    r6, #0xffff         ; inverse: 1 - bit
    add   r7, r6
    and   r7, #1
.q_put:
    push  r7
    ld    r7, [fp+9]
    ld    r6, [fp+0]
    add   r7, r6
    push  r7
    ld    r7, [fp+10]
    ld    r6, [fp+5]
    add   r7, r6
    push  r7
    ccall lcd_set_pixel
    .dw   0x830d, 0x2b07
    ld    r7, [fp+5]
    add   r7, #1
    st    [fp+5], r7
    jmp   .q_row
.q_stock:
    mov   r7, #7
    st    [fp+6], r7
    .dw   0xd0ce, 0x04971

ao_images:
    .dw   ao_g_icon, ao_g_head, ao_g_big, ao_g_batt, ao_g_batt_hi, ao_g_cable, ao_g_cable_hi
ao_g_icon:
    .dw   0x0018, 0x0018, 0x0000, 0x0000, 0x0000, 0x0000, 0x00ff, 0x0000, 0x03ff, 0xc000, 0x0700, 0xe000
    .dw   0x0e00, 0x7000, 0x1c00, 0x3800, 0x1800, 0x1800, 0x3000, 0x0c00, 0x3000, 0x0c00, 0x3000, 0x0c00
    .dw   0x33f8, 0x0c00, 0x33f8, 0x0c00, 0x3018, 0x0c00, 0x3018, 0x0c00, 0x3018, 0x0c00, 0x1800, 0x1800
    .dw   0x1c00, 0x3800, 0x0e00, 0x7000, 0x0700, 0xe000, 0x03ff, 0xc000, 0x00ff, 0x0000, 0x0000, 0x0000
    .dw   0x0000, 0x0000
ao_g_head:
    .dw   0x0040, 0x0008, 0xff00, 0xff00, 0xff00, 0xff00, 0xff00, 0xff00, 0xff00, 0xff00, 0xff00, 0xff00
    .dw   0xff00, 0xff00, 0xe100, 0xdb00, 0xdb00, 0xe100, 0xff00, 0xc300, 0xfd00, 0xfd00, 0xc300, 0xff00
    .dw   0xdf00, 0xc100, 0xdf00, 0xff00, 0xe300, 0xdd00, 0xdd00, 0xe300, 0xff00, 0xff00, 0xff00, 0xff00
    .dw   0xe300, 0xdd00, 0xdd00, 0xe300, 0xff00, 0xc100, 0xd700, 0xdf00, 0xff00, 0xc100, 0xd700, 0xdf00
    .dw   0xff00, 0xff00, 0xff00, 0xff00, 0xff00, 0xff00, 0xff00, 0xff00, 0xff00, 0xff00, 0xff00, 0x7f00
    .dw   0x3f00, 0x1f00, 0x0f00, 0x0700, 0x0300, 0x0100
ao_g_big:
    .dw   0x0036, 0x002c, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000
    .dw   0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000
    .dw   0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000, 0x0000
    .dw   0x0000, 0x0000, 0x0000, 0x3ff0, 0x0000, 0x0001, 0xfffe, 0x0000, 0x0003, 0xc00f, 0x0000, 0x0007
    .dw   0x0003, 0x8000, 0x000e, 0x0001, 0xc000, 0x001c, 0x0000, 0xe000, 0x0038, 0x0000, 0x7000, 0x0070
    .dw   0x0000, 0x3800, 0x0060, 0x0000, 0x1800, 0x0060, 0x0000, 0x1800, 0x00c0, 0x0000, 0x0c00, 0x00c0
    .dw   0x0000, 0x0c00, 0x00c0, 0x0000, 0x0c00, 0x00c0, 0x0000, 0x0c00, 0x00c7, 0xff00, 0x0c00, 0x00c7
    .dw   0xff00, 0x0c00, 0x00c0, 0x0300, 0x0c00, 0x00c0, 0x0300, 0x0c00, 0x00c0, 0x0300, 0x0c00, 0x00c0
    .dw   0x0300, 0x0c00, 0x0060, 0x0300, 0x1800, 0x0060, 0x0300, 0x1800, 0x0070, 0x0000, 0x3800, 0x0038
