.patch fb_test
.title "doom-piano: VOL+/VOL- on the main screen starts/stops a framebuffer test (far data, game loop, timings)"
; Generated by doom-piano/firmware/fbtest.py, do not edit by hand. Our own code and data only.

.hook 0x03fce expect 0xd7c8 0x54a8     ; volume handler, op 0, main screen: ccall of the VOL redraw
    call  dp_vol
.end
.hook 0x007ea expect 0xd7c8 0x4e75     ; tick_10ms: ccall lcd_refresh (sends the framebuffer when flagged)
    call  dp_tick
.end

.code
.equ dp_on, 0x6500
.equ dp_t, 0x6501
.equ dp_tk, 0x6502
.equ dp_sec, 0x6503
.equ dp_c0, 0x6504
.equ dp_d, 0x6505
.equ dp_b, 0x6506
.equ dp_l, 0x6507
.equ dp_n, 0x6508
.equ dp_x, 0x6509
.equ dp_dx, 0x650a
.equ dp_y, 0x650b
.equ dp_dy, 0x650c
.equ dp_lx, 0x650d
.equ dp_i, 0x650e
.equ dp_k, 0x650f
.equ dp_v, 0x6510
.equ dp_ad, 0x6511
.equ dp_tab, 0x6518
.equ dp_div, 0x6520
.equ dp_fnt, 0x6530

dp_vol:                                 ; start (card, then the loop) or stop
    ld    r7, [dp_on]
    cmp   r7, #0
    beq   .start
    mov   r7, #0
    st    [dp_on], r7
    ret
.start:
    mov   r7, #1
    st    [dp_on], r7
    mov   r7, #0
    st    [dp_t], r7
    st    [dp_tk], r7
    st    [dp_sec], r7
    st    [dp_d], r7
    st    [dp_b], r7
    st    [dp_l], r7
    st    [dp_lx], r7
    mov   r7, #40
    st    [dp_x], r7
    mov   r7, #20
    st    [dp_y], r7
    mov   r7, #1
    st    [dp_dx], r7
    st    [dp_dy], r7
    li    r4, #(dp_card >> 16)          ; far -> RAM with the firmware's copy, called as init_all does (0x4928)
    li    r5, #(dp_card & 0xffff)
    li    r2, #framebuffer
    .dw   0x8309                        ; mov r3, x9
    li    r7, #1024
    call  0x7638
    li    r4, #(dp_data >> 16)
    li    r5, #(dp_data & 0xffff)
    li    r2, #dp_tab
    .dw   0x8309                        ; mov r3, x9
    li    r7, #66
    call  0x7638
    ld    r7, [0x6a50]                  ; bit 0: the tick sends the framebuffer to the LCD
    mov   r6, #1
    or    r7, r6
    st    [0x6a50], r7
    ret

dp_tick:                                ; in place of tick_10ms's ccall lcd_refresh
    ld    r7, [dp_on]
    cmp   r7, #0
    beq   .refresh
    ld    r7, [dp_t]
    add   r7, #1
    st    [dp_t], r7
    li    r6, #300                      ; the card stays 3 s
    cmp   r7, r6
    blt   .refresh
    bne   .run
    call  dp_bench                      ; once
.run:
    ld    r7, [dp_tk]
    add   r7, #1
    st    [dp_tk], r7
    cmp   r7, #100
    blt   .draw
    mov   r7, #0
    st    [dp_tk], r7
    ld    r7, [dp_sec]
    add   r7, #1
    st    [dp_sec], r7
    ld    r7, [0x295a]
    ld    r6, [dp_c0]
    st    [dp_c0], r7
    .dw   0xaf06                        ; sub r7, r6
    st    [dp_d], r7
.draw:
    call  dp_frame
.refresh:
    ccall 0x4e75
    ret

dp_bench:                               ; R: 100 frames back to back, L: 100 refreshes of the whole LCD
    ld    r7, [0x295a]
    st    [dp_c0], r7
    mov   r7, #100
    st    [dp_n], r7
.r:
    call  dp_frame
    ld    r7, [dp_n]
    li    r6, #0xffff
    add   r7, r6
    st    [dp_n], r7
    cmp   r7, #0
    bne   .r
    ld    r7, [0x295a]
    ld    r6, [dp_c0]
    .dw   0xaf06                        ; sub r7, r6
    st    [dp_b], r7
    ld    r7, [0x295a]
    st    [dp_c0], r7
    mov   r7, #100
    st    [dp_n], r7
.l:
    ld    r7, [0x6a50]
    mov   r6, #1
    or    r7, r6
    st    [0x6a50], r7
    ccall 0x4e75
    ld    r7, [dp_n]
    li    r6, #0xffff
    add   r7, r6
    st    [dp_n], r7
    cmp   r7, #0
    bne   .l
    ld    r7, [0x295a]
    ld    r6, [dp_c0]
    .dw   0xaf06                        ; sub r7, r6
    st    [dp_l], r7
    ld    r7, [0x295a]
    st    [dp_c0], r7
    ret
.end

.code 0x1a280
; far, leaf (calls nothing): one whole frame into the framebuffer, then the refresh flag
dp_frame:
    li    r1, #framebuffer
    li    r6, #(framebuffer + 1024)
    mov   r7, #0
.clr:
    st    [r1+0], r7
    st    [r1+1], r7
    st    [r1+2], r7
    st    [r1+3], r7
    add   r1, #4
    cmp   r1, r6
    bne   .clr
    ld    r7, [dp_lx]                   ; a vertical line sweeping the screen
    add   r7, #1
    and   r7, #127
    st    [dp_lx], r7
    li    r1, #framebuffer
    add   r1, r7
    mov   r6, #0xff
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    add   r1, #128
    st    [r1+0], r6
    ld    r7, [dp_x]                    ; the box bounces in x 32..120, y 0..56
    ld    r6, [dp_dx]
    add   r7, r6
    st    [dp_x], r7
    cmp   r7, #120
    blt   .x1
    li    r6, #0xffff
    st    [dp_dx], r6
.x1:
    cmp   r7, #33
    blt   .x2
    jmp   .x3
.x2:
    mov   r6, #1
    st    [dp_dx], r6
.x3:
    ld    r7, [dp_y]
    ld    r6, [dp_dy]
    add   r7, r6
    st    [dp_y], r7
    cmp   r7, #56
    blt   .y1
    li    r6, #0xffff
    st    [dp_dy], r6
.y1:
    cmp   r7, #1
    blt   .y2
    jmp   .y3
.y2:
    mov   r6, #1
    st    [dp_dy], r6
.y3:
    mov   r6, r7                        ; r6 = y & 7, r7 = page
    and   r6, #7
    shr   r7, 3
    mov   r5, #0xff                     ; r5 = rows in this page, r4 = rows in the next one
    mov   r4, #0xff
    mov   r2, #0
.m:
    cmp   r2, r6
    blt   .ms
    shr   r4, 1
    jmp   .mn
.ms:
    shl   r5, 1
.mn:
    add   r2, #1
    cmp   r2, #8
    bne   .m
    and   r5, #0xff
    shl   r7, 7
    li    r1, #framebuffer
    add   r1, r7
    ld    r7, [dp_x]
    add   r1, r7
    ld    r7, [r1+0]
    or    r7, r5
    st    [r1+0], r7
    ld    r7, [r1+1]
    or    r7, r5
    st    [r1+1], r7
    ld    r7, [r1+2]
    or    r7, r5
    st    [r1+2], r7
    ld    r7, [r1+3]
    or    r7, r5
    st    [r1+3], r7
    ld    r7, [r1+4]
    or    r7, r5
    st    [r1+4], r7
    ld    r7, [r1+5]
    or    r7, r5
    st    [r1+5], r7
    ld    r7, [r1+6]
    or    r7, r5
    st    [r1+6], r7
    ld    r7, [r1+7]
    or    r7, r5
    st    [r1+7], r7
    cmp   r4, #0
    beq   .nohi
    add   r1, #128
    ld    r7, [r1+0]
    or    r7, r4
    st    [r1+0], r7
    ld    r7, [r1+1]
    or    r7, r4
    st    [r1+1], r7
    ld    r7, [r1+2]
    or    r7, r4
    st    [r1+2], r7
    ld    r7, [r1+3]
    or    r7, r4
    st    [r1+3], r7
    ld    r7, [r1+4]
    or    r7, r4
    st    [r1+4], r7
    ld    r7, [r1+5]
    or    r7, r4
    st    [r1+5], r7
    ld    r7, [r1+6]
    or    r7, r4
    st    [r1+6], r7
    ld    r7, [r1+7]
    or    r7, r4
    st    [r1+7], r7
.nohi:
    mov   r7, #0                        ; the numbers: line i in page i, a letter and 5 digits
    st    [dp_i], r7
.line:
    ld    r7, [dp_i]
    shl   r7, 7
    li    r6, #framebuffer
    add   r7, r6
    st    [dp_ad], r7
    ld    r7, [dp_i]
    shl   r7, 1
    li    r1, #dp_tab
    add   r1, r7
    ld    r6, [r1+0]                    ; the letter
    ld    r1, [r1+1]                    ; the variable
    ld    r7, [r1+0]
    st    [dp_v], r7
    mov   r7, #0
    st    [dp_k], r7
    mov   r7, r6
.glyph:                                 ; glyph r7 at dp_ad (rows 1..5 of the page), then a blank column
    mov   r6, r7
    shl   r6, 1
    add   r6, r7
    li    r1, #dp_fnt
    add   r1, r6
    ld    r5, [r1+0]
    ld    r4, [r1+1]
    ld    r3, [r1+2]
    shl   r5, 1
    shl   r4, 1
    shl   r3, 1
    ld    r1, [dp_ad]
    st    [r1+0], r5
    st    [r1+1], r4
    st    [r1+2], r3
    mov   r7, #0
    st    [r1+3], r7
    add   r1, #4
    st    [dp_ad], r1
    ld    r7, [dp_k]                    ; next digit: divisor pairs (d, -d)
    cmp   r7, #5
    beq   .lnext
    mov   r6, r7
    shl   r6, 1
    li    r1, #dp_div
    add   r1, r6
    add   r7, #1
    st    [dp_k], r7
    ld    r6, [r1+0]
    ld    r4, [r1+1]
    ld    r5, [dp_v]
    mov   r7, #0
.dv:
    cmp   r5, r6
    blt   .dd
    add   r5, r4
    add   r7, #1
    jmp   .dv
.dd:
    st    [dp_v], r5
    jmp   .glyph
.lnext:
    ld    r7, [dp_i]
    add   r7, #1
    st    [dp_i], r7
    cmp   r7, #4
    bne   .line
    ld    r7, [0x6a50]
    mov   r6, #1
    or    r7, r6
    st    [0x6a50], r7
    ret
